{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "features-carousel-2",
  "type": "registry:block",
  "title": "Features Carousel 2",
  "description": "Tailark features-carousel variant 2 block",
  "registryDependencies": [
    "@tailark/card",
    "@tailark/carousel",
    "@tailark/core-utils"
  ],
  "meta": {
    "aspect-ratio": "60/37",

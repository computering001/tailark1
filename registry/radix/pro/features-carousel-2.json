  "files": [
    {
      "path": "blocks/features-carousel/two/index.tsx",
      "type": "registry:component",
      "target": "@components/features-carousel-2.tsx",
      "content": "import { Card } from '@/components/ui/card'\nimport { Notes } from '@/components/illustrations/notes'\nimport { Notes3 } from '@/components/illustrations/notes-3'\nimport { AiAutocomplete } from '@/components/illustrations/ai-autocomplete'\nimport { TranslationInterface } from '@/components/illustrations/translation-interface'\nimport { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel'\nimport Image from 'next/image'\n\nexport default function FeaturesSliderSection() {\n    return (\n        <section className=\"bg-background @container py-24 max-lg:px-1\">\n            <Carousel\n                opts={{\n                    align: 'start',\n                    loop: true,\n                    breakpoints: {\n                        '(max-width: 768px)': {\n                            slidesToScroll: 1,\n                        },\n                        '(min-width: 768px)': {\n                            slidesToScroll: 2,\n                        },\n                    },\n                }}\n                className=\"mx-auto max-w-5xl\">\n                <div className=\"mb-6 flex flex-wrap items-end justify-between gap-4 px-6 lg:mb-10\">\n                    <h2 className=\"text-foreground max-w-xs text-balance text-4xl font-semibold tracking-tight\">Powerful features for modern teams</h2>\n                    <div className=\"flex items-center gap-2\">\n                        <CarouselPrevious />\n                        <CarouselNext />\n                    </div>\n                </div>\n                <CarouselContent className=\"gap-1 pt-6\">\n                    <CarouselItem className=\"space-y-4 md:basis-1/2\">\n                        <Card className=\"inset-ring-1 inset-ring-border-illustration shadow-black/4 relative flex aspect-square items-center justify-center overflow-hidden rounded-2xl shadow-md ring-0\">\n                            <Image\n                                src=\"https://raw.githubusercontent.com/tailark/assets/refs/heads/main/c1_sc01ut.png\"\n                                alt=\"bg c1\"\n                                width={980}\n                                height={980}\n                                className=\"absolute inset-0 size-full opacity-50\"\n                            />\n                            <div className=\"scale-90\">\n                                <Notes />\n                            </div>\n                        </Card>\n                        <p className=\"text-muted-foreground text-balance\">\n                            <strong className=\"text-foreground font-medium\">Smart email composition</strong> with AI-powered suggestions, templates, and seamless collaboration for faster communication.\n                        </p>\n                    </CarouselItem>\n                    <CarouselItem className=\"space-y-4 md:basis-1/2\">\n                        <Card className=\"inset-ring-1 inset-ring-border-illustration shadow-black/4 relative flex aspect-square items-center justify-center overflow-hidden rounded-2xl shadow-md ring-0\">\n                            <Image\n                                src=\"https://raw.githubusercontent.com/tailark/assets/refs/heads/main/c2_ynz6fw.png\"\n                                alt=\"bg c2\"\n                                width={980}\n                                height={980}\n                                className=\"absolute inset-0 size-full opacity-50\"\n                            />\n                            <div className=\"scale-90\">\n                                <Notes3 />\n                            </div>\n                        </Card>\n\n                        <p className=\"text-muted-foreground text-balance\">\n                            <strong className=\"text-foreground font-medium\">Organized note-taking</strong> with rich formatting, tagging, and instant search to capture and retrieve ideas effortlessly.\n                        </p>\n                    </CarouselItem>\n                    <CarouselItem className=\"space-y-4 md:basis-1/2\">\n                        <Card className=\"inset-ring-1 inset-ring-border-illustration shadow-black/4 relative flex aspect-square items-center justify-center overflow-hidden rounded-2xl shadow-md ring-0\">\n                            <Image\n                                src=\"https://raw.githubusercontent.com/tailark/assets/refs/heads/main/c3_fzqepj.png\"\n                                alt=\"bg c3\"\n                                width={980}\n                                height={980}\n                                className=\"absolute inset-0 size-full opacity-50\"\n                            />\n                            <div className=\"scale-90\">\n                                <AiAutocomplete />\n                            </div>\n                        </Card>\n                        <p className=\"text-muted-foreground text-balance\">\n                            <strong className=\"text-foreground font-medium\">AI autocomplete</strong> that learns your writing style and provides context-aware suggestions to boost productivity.\n                        </p>\n                    </CarouselItem>\n                    <CarouselItem className=\"space-y-4 md:basis-1/2\">\n                        <Card className=\"inset-ring-1 inset-ring-border-illustration shadow-black/4 relative flex aspect-square items-center justify-center overflow-hidden rounded-2xl shadow-md ring-0\">\n                            <Image\n                                src=\"https://raw.githubusercontent.com/tailark/assets/refs/heads/main/c4_rg6vjt.png\"\n                                alt=\"bg c4\"\n                                width={980}\n                                height={980}\n                                className=\"absolute inset-0 size-full opacity-50\"\n                            />\n                            <div className=\"scale-90\">\n                                <TranslationInterface />\n                            </div>\n                        </Card>\n                        <p className=\"text-muted-foreground text-balance\">\n                            <strong className=\"text-foreground font-medium\">Real-time translation</strong> across 50+ languages with automatic detection and natural-sounding output for global teams.\n                        </p>\n                    </CarouselItem>\n                </CarouselContent>\n            </Carousel>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/features-carousel/two/illustrations/ai-autocomplete.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/ai-autocomplete.tsx",
      "content": "import { CornerDownLeft, Sparkles } from 'lucide-react'\n\nexport const AiAutocomplete = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"min-w-2xs\">\n            <div className=\"ring-border-illustration relative rounded-lg p-3 ring-1\">\n                <div className=\"relative flex w-fit items-center gap-1\">\n                    <div className=\"bg-linear-to-r absolute inset-0 h-5 via-indigo-500/15 to-emerald-500/15\"></div>\n\n                    <span className=\"text-xs\">How do I implement</span>\n                    <div className=\"text-primary h-5 w-px animate-pulse bg-current\"></div>\n                </div>\n            </div>\n\n            <div className=\"bg-illustration ring-border-illustration dark:ring-foreground/25 shadow-black/6.5 mt-2 overflow-hidden rounded-xl shadow-lg ring-1\">\n                <div className=\"bg-primary/10 border-primary/20 flex items-center gap-2 border-b px-3 py-2\">\n                    <Sparkles className=\"text-primary fill-primary *:nth-2:text-purple-400 *:nth-3:text-purple-400 *:not-first:text-foreground/25 size-3.5\" />\n                    <div className=\"text-xs font-medium\">AI Suggestions</div>\n                </div>\n\n                <div className=\"divide-border divide-y\">\n                    <div className=\"bg-primary/5 flex cursor-pointer items-center gap-2 px-3 py-2.5 transition-colors\">\n                        <div className=\"flex-1 text-xs\">...authentication with OAuth 2.0?</div>\n                        <div className=\"bg-background ring-border-illustration text-muted-foreground flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] ring-1\">\n                            <CornerDownLeft className=\"size-2.5\" />\n                            Tab\n                        </div>\n                    </div>\n\n                    <div className=\"hover:bg-muted/50 flex cursor-pointer items-center gap-2 px-3 py-2.5 transition-colors\">\n                        <div className=\"text-muted-foreground flex-1 text-xs\">...a dark mode toggle in React?</div>\n                    </div>\n\n                    <div className=\"hover:bg-muted/50 flex cursor-pointer items-center gap-2 px-3 py-2.5 transition-colors\">\n                        <div className=\"text-muted-foreground flex-1 text-xs\">...caching for API responses?</div>\n                    </div>\n                </div>\n            </div>\n\n            <div className=\"mt-4 flex items-center justify-between text-xs\">\n                <div className=\"text-muted-foreground\">3 suggestions</div>\n                <div className=\"text-muted-foreground flex items-center gap-1\">\n                    <span className=\"bg-background ring-border-illustration rounded px-1 ring-1\">↑</span>\n                    <span className=\"bg-background ring-border-illustration rounded px-1 ring-1\">↓</span>\n                    to navigate\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/features-carousel/two/illustrations/notes-3.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/notes-3.tsx",
      "content": "\"use client\"\nimport { cn } from \"@/lib/utils\"\nimport { Check, Circle } from \"lucide-react\"\nimport { useState } from \"react\"\n\nexport const Notes3 = () => {\n  const [tasks, setTasks] = useState([\n    { id: 1, text: \"Review pull requests\", completed: true },\n    { id: 2, text: \"Update documentation\", completed: true },\n    { id: 3, text: \"Deploy to staging\", completed: true },\n    { id: 4, text: \"Write unit tests\", completed: false },\n    { id: 5, text: \"Send weekly report\", completed: false },\n  ])\n\n  const toggleTask = (id: number) => {\n    setTasks(\n      tasks.map((task) =>\n        task.id === id ? { ...task, completed: !task.completed } : task\n      )\n    )\n  }\n\n  const completedCount = tasks.filter((task) => task.completed).length\n\n  return (\n    <div className=\"max-w-xs min-w-2xs px-4 pt-4 selection:bg-amber-500/25\">\n      <div className=\"relative\">\n        <div className=\"absolute right-1 -bottom-2 left-1 h-full rotate-2 rounded-sm bg-linear-to-br from-amber-200 to-yellow-300 shadow-sm dark:from-amber-300 dark:to-yellow-400\" />\n        <div className=\"absolute right-0.5 -bottom-1 left-0.5 h-full -rotate-1 rounded-sm bg-linear-to-br from-amber-100 to-yellow-200 shadow-sm dark:from-amber-200 dark:to-yellow-300\" />\n        <div className=\"relative rounded-sm bg-linear-to-br from-amber-100 to-yellow-200 p-5 pb-12 shadow-lg shadow-amber-900/15 dark:from-amber-300 dark:to-yellow-300\">\n          <div className=\"mb-4 flex items-center justify-between pt-2\">\n            <span className=\"text-sm font-semibold text-amber-950\">\n              Quick Tasks\n            </span>\n            <span className=\"text-xs text-amber-700\">\n              {completedCount}/{tasks.length}\n            </span>\n          </div>\n          <div className=\"space-y-2\">\n            {tasks.map((task) => (\n              <button\n                type=\"button\"\n                key={task.id}\n                aria-pressed={task.completed}\n                className=\"flex cursor-pointer items-center gap-2.5\"\n                onClick={() => toggleTask(task.id)}\n              >\n                {task.completed ? (\n                  <div className=\"flex size-4 items-center justify-center rounded bg-emerald-500/30\">\n                    <Check className=\"size-3 text-emerald-700\" />\n                  </div>\n                ) : (\n                  <Circle className=\"size-4 text-amber-700/40\" />\n                )}\n                <span\n                  className={cn(\n                    \"text-sm font-medium\",\n                    task.completed\n                      ? \"text-amber-800/60 line-through\"\n                      : \"text-amber-900 dark:text-amber-950\"\n                  )}\n                >\n                  {task.text}\n                </span>\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n"
    },
    {
      "path": "blocks/features-carousel/two/illustrations/notes.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/notes.tsx",
      "content": "import { Play } from 'lucide-react'\n\nexport const Notes = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"max-w-xs\">\n            <div className=\"bg-illustration shadow-black/6.5 ring-border-illustration z-1 relative rounded-2xl p-6 shadow-lg ring-1\">\n                <span className=\"text-muted-foreground text-xs\">\n                    Today <span className=\"bg-foreground/50 size-0.5 rounded-full\"></span> <span>09:15 AM</span>{' '}\n                </span>\n                <div className=\"mb-4 mt-1 text-lg font-semibold\">Marketing Website Launch</div>\n                <span className=\"text-muted-foreground\">The new marketing website is scheduled to go live next Monday.</span> <span className=\"text-foreground font-medium\">Key highlights include a redesigned hero section, improved SEO structure,</span> <span className=\"text-muted-foreground\">and integrated analytics dashboard for tracking conversion rates.</span>\n                <div className=\"bg-foreground/10 group relative mt-6 h-fit w-fit cursor-pointer overflow-hidden rounded-full p-px shadow-md shadow-black/5\">\n                    <div className=\"bg-linear-to-br/increasing mask-r-to-75% mask-r-from-25% transition-opacity duration-2000 absolute inset-0 aspect-square -translate-y-1/3 animate-spin from-emerald-400 via-blue-500 to-indigo-400 opacity-50\"></div>\n                    <div className=\"group-hover:bg-illustration bg-background/95 relative flex h-8 items-center gap-1.5 rounded-full px-3 text-sm transition-colors duration-100\">\n                        <Play className=\"fill-foreground *:not-first:opacity-50 size-3\" />\n                        03:47\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/features-carousel/two/illustrations/translation-interface.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/translation-interface.tsx",
      "content": "export const TranslationInterface = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"min-w-xs max-w-xs\">\n            <div className=\"space-y-3\">\n                <div className=\"mask-y-from-35%\">\n                    <p className=\"text-sm/6\">Corporis voluptates voluptatem atque excepturi, tempore dolor distinctio libero dicta vel, nihil rem consequatur esse aspernatur nostrum, minus magnam labore quas optio?</p>\n                </div>\n\n                <div className=\"relative flex w-fit items-center gap-1\">\n                    <span className=\"bg-linear-to-r from-primary rounded to-emerald-500 bg-clip-text text-sm text-transparent dark:from-white dark:via-indigo-300\">Auto translated from English</span>\n                </div>\n\n                <div className=\"bg-illustration ring-primary/50 dark:ring-foreground/50 shadow-black/6.5 rounded-xl p-3 shadow-md ring-1\">\n                    <div className=\"text-muted-foreground mb-3 text-xs\">Spanish</div>\n\n                    <p className=\"text-foreground text-sm/6\">Hola, ¿cómo puedo ayudarte hoy? Estoy aquí para responder cualquier pregunta que tengas sobre nuestros servicios y productos.</p>\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    }
  ]
}

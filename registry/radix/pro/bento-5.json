  "files": [
    {
      "path": "blocks/bento/five/index.tsx",
      "type": "registry:component",
      "target": "@components/bento-5.tsx",
      "content": "import { Card } from '@/components/ui/card'\nimport { Chart } from '@/components/illustrations/chart'\nimport { Document } from '@/components/illustrations/document'\nimport { Keys } from '@/components/illustrations/keys'\nimport { FingerprintScan } from '@/components/illustrations/fingerprint-scan'\nimport { Campaign } from '@/components/illustrations/campaign'\n\nexport default function SmartHomeBento() {\n    return (\n        <section className=\"bg-background @container py-24\">\n            <div className=\"mx-auto w-full max-w-5xl px-6\">\n                <div className=\"@xl:grid-cols-2 @4xl:grid-cols-10 grid grid-cols-1 gap-3\">\n                    <Card className=\"@4xl:col-span-4 group grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n                        <div>\n                            <h3 className=\"text-foreground font-semibold\">Smart Lighting Control</h3>\n                            <p className=\"text-muted-foreground mt-3\">Automate your home lighting with customizable schedules.</p>\n                        </div>\n                        <Keys />\n                    </Card>\n                    <Card className=\"@xl:col-span-2 @4xl:col-span-6 grid grid-rows-[auto_1fr] gap-8 rounded-2xl p-8 [--color-background:var(--color-muted)]\">\n                        <div>\n                            <h3 className=\"text-foreground font-semibold\">Interactive Dashboards</h3>\n                            <p className=\"text-muted-foreground mt-3\">Create custom dashboards with drag-and-drop simplicity. Automate your home lighting with customizable schedules.</p>\n                        </div>\n                        <div className=\"relative\">\n                            <Chart />\n                        </div>\n                    </Card>\n                    <Card\n                        data-theme=\"dark\"\n                        className=\"@4xl:col-span-3 group grid grid-rows-[1fr_auto] gap-8 overflow-hidden rounded-2xl p-8\">\n                        <FingerprintScan />\n                        <div>\n                            <h3 className=\"text-foreground font-semibold\">Smart Lighting Control</h3>\n                            <p className=\"text-muted-foreground mt-3\">Automate your home lighting with customizable schedules.</p>\n                        </div>\n                    </Card>\n                    <Card className=\"@4xl:col-span-4 group grid grid-rows-[1fr_auto] gap-8 overflow-hidden rounded-2xl p-8 [--color-background:var(--color-muted)]\">\n                        <Campaign />\n                        <div>\n                            <h3 className=\"text-foreground font-semibold\">Smart Lighting Control</h3>\n                            <p className=\"text-muted-foreground mt-3\">Automate your home lighting with customizable schedules.</p>\n                        </div>\n                    </Card>\n                    <Card className=\"@4xl:row-start-auto @4xl:col-span-3 row-start-1 grid grid-rows-[1fr_auto] gap-8 overflow-hidden rounded-2xl p-8\">\n                        <div className=\"**:mt-0 grid h-fit grid-cols-3 gap-3\">\n                            <Document />\n                            <Document />\n                            <Document />\n                            <Document />\n                            <Document />\n                            <Document />\n                        </div>\n                        <div>\n                            <h3 className=\"text-foreground font-semibold\">Collaborative Analysis</h3>\n                            <p className=\"text-muted-foreground mt-3\">Add comments, share insights, and work together.</p>\n                        </div>\n                    </Card>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/five/illustrations/campaign.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/campaign.tsx",
      "content": "export const Campaign = () => (\n    <div\n        aria-hidden\n        className=\"before:z-1 mask-b-from-65% before:bg-card after:bg-card before:border-foreground/10 after:border-foreground/5 group relative -mx-4 px-4 pt-6 before:absolute before:inset-x-6 before:bottom-0 before:top-4 before:rounded-2xl before:border after:absolute after:inset-x-8 after:bottom-0 after:top-2 after:rounded-2xl after:border\">\n        <div className=\"bg-card border-border-illustration relative z-10 h-full rounded-t-2xl border p-4 pb-10 text-xs shadow-lg transition-shadow duration-300\">\n            <div className=\"mb-0.5 text-sm font-semibold\">Compaign</div>\n            <div className=\"mb-4 flex gap-2 text-sm\">\n                <span>Loyalty program</span>\n                <span className=\"text-muted-foreground\">loyalty program</span>\n            </div>\n            <div className=\"@md:grid-cols-2 mb-4 grid gap-2\">\n                <div className=\"bg-illustration border-border-illustration flex gap-2 rounded-md border p-2\">\n                    <div className=\"bg-primary w-1 rounded-full\"></div>\n\n                    <div>\n                        <div className=\"text-sm font-medium\">Start Date</div>\n                        <div className=\"text-muted-foreground line-clamp-1\">Feb 6, 2024 at 00:00</div>\n                    </div>\n                </div>\n                <div className=\"bg-illustration border-border-illustration flex gap-2 rounded-md border p-2\">\n                    <div className=\"bg-primary w-1 rounded-full\"></div>\n\n                    <div>\n                        <div className=\"text-sm font-medium\">Start Date</div>\n                        <div className=\"text-muted-foreground line-clamp-1\">Feb 6, 2024 at 00:00</div>\n                    </div>\n                </div>\n            </div>\n\n            <p>\n                Connected to 12 <span className=\"text-primary font-medium\">Marketing Campaigns</span>.\n            </p>\n        </div>\n    </div>\n)\n"
    },
    {
      "path": "blocks/bento/five/illustrations/chart.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/chart.tsx",
      "content": "'use client'\nimport dynamic from 'next/dynamic'\nimport { type ChartConfig, ChartContainer, ChartTooltipContent } from '@/components/ui/chart'\n\nconst chartConfig = {\n    desktop: {\n        label: 'Desktop',\n        color: 'var(--color-indigo-500)',\n    },\n    mobile: {\n        label: 'Mobile',\n        color: 'var(--color-emerald-400)',\n    },\n} satisfies ChartConfig\n\nconst chartData = [\n    { month: 'May', desktop: 56, mobile: 224 },\n    { month: 'June', desktop: 56, mobile: 224 },\n    { month: 'January', desktop: 126, mobile: 252 },\n    { month: 'February', desktop: 205, mobile: 410 },\n    { month: 'March', desktop: 200, mobile: 126 },\n    { month: 'April', desktop: 400, mobile: 800 },\n]\n\ntype RechartsChartProps = import('react').ComponentProps<(typeof import('recharts'))['AreaChart']>\n\nconst RechartsChart = dynamic<RechartsChartProps>(() =>\n    import('recharts').then(({ Area, AreaChart, CartesianGrid, Tooltip }) => {\n        function LoadedChart(props: RechartsChartProps) {\n            return (\n                <AreaChart\n                    {...props}\n                    accessibilityLayer\n                    data={chartData}\n                    margin={{\n                        left: 0,\n                        right: 0,\n                    }}>\n                    <defs>\n                        <linearGradient id=\"fillDesktop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.1} />\n                        </linearGradient>\n                        <linearGradient id=\"fillMobile\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.1} />\n                        </linearGradient>\n                    </defs>\n                    <CartesianGrid vertical={false} />\n                    <Tooltip active content={<ChartTooltipContent className=\"dark:bg-zinc-900\" />} />\n                    <Area strokeWidth={2} dataKey=\"mobile\" type=\"natural\" fill=\"url(#fillMobile)\" fillOpacity={0.1} stroke=\"var(--color-mobile)\" stackId=\"a\" />\n                    <Area strokeWidth={2} dataKey=\"desktop\" type=\"natural\" fill=\"url(#fillDesktop)\" fillOpacity={0.1} stroke=\"var(--color-desktop)\" stackId=\"a\" />\n                </AreaChart>\n            )\n        }\n\n        return LoadedChart\n    })\n)\n\nexport const Chart = () => {\n    return (\n        <ChartContainer className=\"h-120 aspect-auto md:h-56\" config={chartConfig}>\n            <RechartsChart />\n        </ChartContainer>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/five/illustrations/document.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/document.tsx",
      "content": "import { Signature } from 'lucide-react'\nimport { cn } from '@/lib/utils'\n\nexport const Document = ({ className }: { className?: string }) => {\n    return (\n        <div className={cn('bg-illustration ring-border-illustration shadow-black/6.5 w-16 space-y-2 rounded-md p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)]', className)}>\n            <div className=\"flex items-center gap-1\">\n                <div className=\"bg-primary size-2.5 rounded-full\"></div>\n                <div className=\"bg-foreground/15 h-[3px] w-4 rounded-full\"></div>\n            </div>\n            <div className=\"space-y-1.5\">\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n            </div>\n\n            <div className=\"space-y-1.5\">\n                <div className=\"bg-foreground/15 h-[3px] w-full rounded-full\"></div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2/3 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-1/3 rounded-full\"></div>\n                </div>\n            </div>\n\n            <Signature className=\"ml-auto size-3\" />\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/five/illustrations/fingerprint-scan.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/fingerprint-scan.tsx",
      "content": "import { cn } from '@/lib/utils'\nimport Image from 'next/image'\n\nexport const FingerprintScan = () => {\n    return (\n        <div className=\"relative aspect-square max-w-64\">\n            <div className=\"mask-radial-from-0% mask-radial-to-75% relative flex aspect-square justify-center\">\n                <Image\n                    src=\"https://raw.githubusercontent.com/tailark/assets/refs/heads/main/fingerprint-scanner_vtvyyq.png\"\n                    alt=\"Fingerprint scanner\"\n                    className=\"size-full scale-110 object-cover\"\n                    width={224}\n                    height={224}\n                />\n            </div>\n            <div className=\"aspect-3/4 bg-linear-to-b from-foreground/5 to-foreground/5 -translate-y-9.5 inset-18 absolute m-auto translate-x-1.5 border border-white/5 via-transparent\">\n                <CardDecorator className=\"border-primary\" />\n                <div className=\"animate-scan absolute inset-0 z-10\">\n                    <div className=\"absolute inset-x-0 m-auto h-2 w-2/3 bg-indigo-500 blur-lg\" />\n                </div>\n            </div>\n        </div>\n    )\n}\n\nexport const CardDecorator = ({ className }: { className?: string }) => (\n    <>\n        <span className={cn('animate-breathing absolute -left-px -top-px block size-2.5 rounded-tl border-l-[1.5px] border-t-[1.5px] border-white', className)}></span>\n        <span className={cn('animate-breathing absolute -right-px -top-px block size-2.5 rounded-tr border-r-[1.5px] border-t-[1.5px] border-white', className)}></span>\n        <span className={cn('animate-breathing absolute -bottom-px -left-px block size-2.5 rounded-bl border-b-[1.5px] border-l-[1.5px] border-white', className)}></span>\n        <span className={cn('animate-breathing absolute -bottom-px -right-px block size-2.5 rounded-br border-b-[1.5px] border-r-[1.5px] border-white', className)}></span>\n    </>\n)\n"
    },
    {
      "path": "blocks/bento/five/illustrations/keys.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/keys.tsx",
      "content": "import { Globe } from 'lucide-react'\n\nexport const Keys = () => (\n    <div\n        aria-hidden\n        className=\"@4xl:aspect-auto flex aspect-video items-center justify-center\">\n        <div className=\"relative mx-auto flex w-fit gap-3\">\n            <div className=\"border-border-illustration absolute -inset-x-6 inset-y-0 border-y border-dashed\"></div>\n            <div className=\"border-border-illustration absolute -inset-y-6 inset-x-0 border-x border-dashed\"></div>\n            <div className=\"dark:ring-background dark:border-border-illustration border-border-illustration bg-foreground/65 relative flex aspect-square size-16 items-center rounded-[7px] border border-white/25 p-3 text-white shadow-lg shadow-black/35 ring ring-black dark:bg-zinc-900\">\n                <span className=\"absolute right-2 top-1 block text-sm\">fn</span>\n                <Globe className=\"mt-auto size-4\" />\n            </div>\n            <div className=\"dark:ring-background dark:border-border-illustration bg-foreground/65 relative flex aspect-square size-16 items-center justify-center rounded-[7px] border border-white/25 p-3 shadow-lg shadow-black/35 ring ring-black dark:bg-zinc-900\">\n                <span className=\"text-white\">K</span>\n            </div>\n        </div>\n    </div>\n)\n\nexport default Keys\n"
    }
  ]
}

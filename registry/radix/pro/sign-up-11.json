{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sign-up-11",
  "type": "registry:block",
  "title": "Sign Up 11",
  "description": "Tailark sign-up variant 11 block",
  "registryDependencies": [
    "@tailark/button",
    "@tailark/input",
    "@tailark/label",
    "@tailark/core-logo"
  ],
  "meta": {
    "aspect-ratio": "90/60",

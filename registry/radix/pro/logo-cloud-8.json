ight={16}\n                            width=\"auto\"\n                        />\n                    </div>\n                    <div className=\"flex items-center justify-center px-2\">\n                        <Supabase\n                            height={20}\n                            width=\"auto\"\n                        />\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n}\n"

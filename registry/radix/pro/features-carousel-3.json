  "files": [
    {
      "path": "blocks/features-carousel/three/index.tsx",
      "type": "registry:component",
      "target": "@components/features-carousel-3.tsx",
      "content": "import { Notes3 } from '@/components/illustrations/notes-3'\nimport { Models3 } from '@/components/illustrations/models-3'\nimport { Workflow } from '@/components/illustrations/workflow'\nimport { AiAutocomplete } from '@/components/illustrations/ai-autocomplete'\nimport { TranslationInterface } from '@/components/illustrations/translation-interface'\nimport { TokenCounter } from '@/components/illustrations/token-counter'\nimport { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel'\n\nexport default function FeaturesSliderSection() {\n    return (\n        <section className=\"bg-background @container max-lg:px-1\">\n            <Carousel\n                opts={{\n                    align: 'start',\n                    loop: true,\n                    breakpoints: {\n                        '(max-width: 768px)': {\n                            slidesToScroll: 1,\n                        },\n                        '(min-width: 768px)': {\n                            slidesToScroll: 2,\n                        },\n                        '(min-width: 1024px)': {\n                            slidesToScroll: 3,\n                        },\n                    },\n                }}\n                className=\"mx-auto\">\n                <div className=\"mx-auto max-w-6xl\">\n                    <div className=\"flex flex-wrap items-end justify-between gap-4 border-x border-dashed px-6 pb-6 pt-24 lg:px-8 lg:pb-12\">\n                        <h2 className=\"text-foreground max-w-xl text-balance text-4xl font-semibold lg:text-5xl tracking-tight\">Build modern AI development tools</h2>\n                        <div className=\"flex items-center gap-2\">\n                            <CarouselPrevious />\n                            <CarouselNext />\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"lg:grid lg:grid-cols-[1fr_auto_1fr]\">\n                    <div\n                        aria-hidden\n                        className=\"border-y border-dashed max-lg:hidden\"\n                    />\n                    <div className=\"mx-auto border lg:max-w-6xl\">\n                        <CarouselContent className=\"*:nth-3:border-r-0 *:bg-card *:not-dark:bg-card/50 *:p-8 *:pt-12 md:divide-x md:*:basis-1/2 lg:-mr-4 lg:*:basis-1/3\">\n                            <CarouselItem className=\"grid-rows-subrgid row-span-2 grid gap-12\">\n                                <div className=\"m-auto scale-90 self-center\">\n                                    <Models3 />\n                                </div>\n\n                                <p className=\"text-foreground/65 self-end text-balance font-medium lg:max-w-xs\">\n                                    <strong className=\"text-foreground font-medium\">Multiple AI models</strong> including GPT-5, Claude, and Llama with seamless switching between providers.\n                                </p>\n                            </CarouselItem>\n                            <CarouselItem className=\"grid-rows-subrgid row-span-2 grid gap-12\">\n                                <div className=\"mx-auto scale-90 self-center\">\n                                    <Notes3 />\n                                </div>\n\n                                <p className=\"text-foreground/65 self-end text-balance font-medium\">\n                                    <strong className=\"text-foreground font-medium\">Collaborative documentation</strong> with version history, inline comments, and real-time editing.\n                                </p>\n                            </CarouselItem>\n                            <CarouselItem className=\"grid-rows-subrgid row-span-2 grid gap-12\">\n                                <div className=\"mx-auto scale-90 self-center\">\n                                    <Workflow />\n                                </div>\n\n                                <p className=\"text-foreground/65 self-end text-balance font-medium\">\n                                    <strong className=\"text-foreground font-medium\">Automated workflows</strong> with drag-and-drop pipeline builder and pre-built integrations.\n                                </p>\n                            </CarouselItem>\n\n                            <CarouselItem className=\"grid-rows-subrgid row-span-2 grid gap-12\">\n                                <div className=\"mx-auto scale-90 self-center\">\n                                    <AiAutocomplete />\n                                </div>\n\n                                <p className=\"text-foreground/65 self-end text-balance font-medium\">\n                                    <strong className=\"text-foreground font-medium\">Intelligent code completion</strong> that understands your codebase and suggests context-aware snippets.\n                                </p>\n                            </CarouselItem>\n                            <CarouselItem className=\"grid-rows-subrgid row-span-2 grid gap-12\">\n                                <div className=\"mx-auto scale-90 self-center\">\n                                    <TokenCounter />\n                                </div>\n\n                                <p className=\"text-foreground/65 self-end text-balance font-medium\">\n                                    <strong className=\"text-foreground font-medium\">Usage analytics</strong> with detailed token tracking, cost estimation, and budget alerts.\n                                </p>\n                            </CarouselItem>\n                            <CarouselItem className=\"grid-rows-subrgid row-span-2 grid gap-12\">\n                                <div className=\"scale-90 self-center\">\n                                    <TranslationInterface />\n                                </div>\n\n                                <p className=\"text-foreground/65 self-end text-balance font-medium\">\n                                    <strong className=\"text-foreground font-medium\">Real-time translation</strong> across 50+ languages with natural-sounding output and dialect support.\n                                </p>\n                            </CarouselItem>\n                        </CarouselContent>\n                    </div>\n                    <div\n                        aria-hidden\n                        className=\"bmax-lg:hidden order-y border-dashed\"\n                    />\n                </div>\n\n                <div className=\"mx-auto w-full max-w-6xl border-x border-dashed pb-24\" />\n            </Carousel>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/features-carousel/three/illustrations/ai-autocomplete.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/ai-autocomplete.tsx",
      "content": "import { CornerDownLeft, Sparkles } from 'lucide-react'\n\nexport const AiAutocomplete = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"min-w-2xs max-w-2xs mx-auto\">\n            <div className=\"ring-border-illustration relative rounded-lg p-3 ring-1\">\n                <div className=\"relative flex w-fit items-center gap-1\">\n                    <div className=\"bg-linear-to-r absolute inset-0 h-5 via-indigo-500/15 to-emerald-500/15\"></div>\n\n                    <span className=\"text-xs\">How do I implement</span>\n                    <div className=\"text-primary h-5 w-px animate-pulse bg-current\"></div>\n                </div>\n            </div>\n\n            <div className=\"bg-illustration ring-border-illustration shadow-black/6.5 mt-2 overflow-hidden rounded-xl shadow-lg ring-1\">\n                <div className=\"bg-primary/10 border-primary/20 flex items-center gap-2 border-b px-3 py-2\">\n                    <Sparkles className=\"text-primary fill-primary *:nth-2:text-purple-400 *:nth-3:text-purple-400 *:not-first:text-foreground/25 size-3.5\" />\n                    <div className=\"text-xs font-medium\">AI Suggestions</div>\n                </div>\n\n                <div className=\"divide-border divide-y\">\n                    <div className=\"bg-primary/5 flex cursor-pointer items-center gap-2 px-3 py-2.5 transition-colors\">\n                        <div className=\"flex-1 text-xs\">...authentication with OAuth 2.0?</div>\n                        <div className=\"bg-background ring-border-illustration text-muted-foreground flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] ring-1\">\n                            <CornerDownLeft className=\"size-2.5\" />\n                            Tab\n                        </div>\n                    </div>\n\n                    <div className=\"hover:bg-muted/50 flex cursor-pointer items-center gap-2 px-3 py-2.5 transition-colors\">\n                        <div className=\"text-muted-foreground flex-1 text-xs\">...a dark mode toggle in React?</div>\n                    </div>\n\n                    <div className=\"hover:bg-muted/50 flex cursor-pointer items-center gap-2 px-3 py-2.5 transition-colors\">\n                        <div className=\"text-muted-foreground flex-1 text-xs\">...caching for API responses?</div>\n                    </div>\n                </div>\n            </div>\n\n            <div className=\"mt-4 flex items-center justify-between text-xs\">\n                <div className=\"text-muted-foreground\">3 suggestions</div>\n                <div className=\"text-muted-foreground flex items-center gap-1\">\n                    <span className=\"bg-background ring-border-illustration rounded px-1 ring-1\">↑</span>\n                    <span className=\"bg-background ring-border-illustration rounded px-1 ring-1\">↓</span>\n                    to navigate\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/features-carousel/three/illustrations/models-3.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/models-3.tsx",
      "content": "import { Gemini } from '@/components/ui/svgs/gemini'\nimport { MistralAi } from '@/components/ui/svgs/mistral-ai'\nimport { Openai } from '@/components/ui/svgs/openai'\nimport { Deepseek } from '@/components/ui/svgs/deepseek'\nimport { QwenLight as Qwen } from '@/components/ui/svgs/qwen'\nimport { Play } from 'lucide-react'\n\ntype Model = {\n    name: string\n    icon: React.ReactNode\n}\n\nconst models: Model[] = [\n    { name: 'Gemini', icon: <Gemini /> },\n    { name: 'Open AI', icon: <Openai className=\"fill-foreground\" /> },\n    { name: 'Deepseek', icon: <Deepseek /> },\n    { name: 'Mistral AI', icon: <MistralAi /> },\n    { name: 'Qwen', icon: <Qwen className=\"fill-foreground\" /> },\n]\n\nexport const Models3 = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"min-w-sm relative\">\n            <div className=\"perspective-dramatic flex flex-col gap-4\">\n                <div className=\"mask-radial-[100%_100%] mask-radial-from-75% mask-radial-at-top-left rotate-x-5 rotate-z-6 -rotate-4 pl-6 pt-1\">\n                    <div className=\"ring-border-illustration bg-background/75 shadow-black/6.5 rounded-tl-2xl px-2 pt-4 shadow-lg ring-1\">\n                        <div className=\"text-muted-foreground mb-3 flex items-center gap-2.5 px-3 font-medium\">\n                            Models <Play className=\"size-2.5 translate-y-0.5 rotate-90 fill-current opacity-50\" />\n                        </div>\n\n                        <div className=\"bg-illustration ring-border-illustration flex flex-col gap-5 rounded-tl-xl pl-5 pt-5 shadow ring-1\">\n                            {models.map((model, index) => (\n                                <div\n                                    key={index}\n                                    className=\"flex origin-bottom items-center gap-2.5 [&>svg]:size-5\">\n                                    {model.icon}\n                                    <span className=\"text-base\">{model.name}</span>\n                                </div>\n                            ))}\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n\nexport default Models3\n"
    },
    {
      "path": "blocks/features-carousel/three/illustrations/notes-3.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/notes-3.tsx",
      "content": "\"use client\"\nimport { cn } from \"@/lib/utils\"\nimport { Check, Circle } from \"lucide-react\"\nimport { useState } from \"react\"\n\nexport const Notes3 = () => {\n  const [tasks, setTasks] = useState([\n    { id: 1, text: \"Review pull requests\", completed: true },\n    { id: 2, text: \"Update documentation\", completed: true },\n    { id: 3, text: \"Deploy to staging\", completed: true },\n    { id: 4, text: \"Write unit tests\", completed: false },\n    { id: 5, text: \"Send weekly report\", completed: false },\n  ])\n\n  const toggleTask = (id: number) => {\n    setTasks(\n      tasks.map((task) =>\n        task.id === id ? { ...task, completed: !task.completed } : task\n      )\n    )\n  }\n\n  const completedCount = tasks.filter((task) => task.completed).length\n\n  return (\n    <div className=\"max-w-xs min-w-2xs px-4 pt-4 selection:bg-amber-500/25\">\n      <div className=\"relative\">\n        <div className=\"absolute right-1 -bottom-2 left-1 h-full rotate-2 rounded-sm bg-linear-to-br from-amber-200 to-yellow-300 shadow-sm dark:from-amber-300 dark:to-yellow-400\" />\n        <div className=\"absolute right-0.5 -bottom-1 left-0.5 h-full -rotate-1 rounded-sm bg-linear-to-br from-amber-100 to-yellow-200 shadow-sm dark:from-amber-200 dark:to-yellow-300\" />\n        <div className=\"relative rounded-sm bg-linear-to-br from-amber-100 to-yellow-200 p-5 pb-12 shadow-lg shadow-amber-900/15 dark:from-amber-300 dark:to-yellow-300\">\n          <div className=\"mb-4 flex items-center justify-between pt-2\">\n            <span className=\"text-sm font-semibold text-amber-950\">\n              Quick Tasks\n            </span>\n            <span className=\"text-xs text-amber-700\">\n              {completedCount}/{tasks.length}\n            </span>\n          </div>\n          <div className=\"space-y-2\">\n            {tasks.map((task) => (\n              <button\n                type=\"button\"\n                key={task.id}\n                aria-pressed={task.completed}\n                className=\"flex cursor-pointer items-center gap-2.5\"\n                onClick={() => toggleTask(task.id)}\n              >\n                {task.completed ? (\n                  <div className=\"flex size-4 items-center justify-center rounded bg-emerald-500/30\">\n                    <Check className=\"size-3 text-emerald-700\" />\n                  </div>\n                ) : (\n                  <Circle className=\"size-4 text-amber-700/40\" />\n                )}\n                <span\n                  className={cn(\n                    \"text-sm font-medium\",\n                    task.completed\n                      ? \"text-amber-800/60 line-through\"\n                      : \"text-amber-900 dark:text-amber-950\"\n                  )}\n                >\n                  {task.text}\n                </span>\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n"
    },
    {
      "path": "blocks/features-carousel/three/illustrations/token-counter.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/token-counter.tsx",
      "content": "export const TokenCounter = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"-mx-4\">\n            <div className=\"mask-radial-[100%_100%] mask-radial-from-75% mask-radial-at-top px-3 pt-1\">\n                <div className=\"min-w-2xs ring-border-illustration bg-background/75 shadow-black/6.5 rounded-t-2xl px-2 pt-4 shadow-lg ring-1\">\n                    <div className=\"text-muted-foreground mb-3 flex items-center gap-2.5 px-3 font-medium\">Usage</div>\n\n                    <div className=\"bg-illustration ring-border-illustration flex flex-col gap-5 rounded-t-xl px-5 pt-5 shadow ring-1\">\n                        <div className=\"space-y-6\">\n                            <div className=\"space-y-2\">\n                                <div className=\"flex items-center justify-between text-xs\">\n                                    <span className=\"text-foreground text-base\">User prompt tokens</span>\n                                    <span className=\"text-foreground font-medium\">43%</span>\n                                </div>\n                                <div className=\"text-muted-foreground text-xs\">Using a premium model costs one prompt credit per use.</div>\n                                <div className=\"relative mt-5\">\n                                    <div className=\"bg-foreground/5 relative h-2 overflow-hidden rounded-full\">\n                                        <div className=\"bg-linear-to-l from-primary before:mask-x-from-65% absolute inset-y-0 left-0 w-[43%] rounded-full to-emerald-500 before:absolute before:inset-0 before:rounded-full before:border before:border-white/20\"></div>\n                                    </div>\n                                    <div className=\"bg-linear-to-l absolute inset-y-0 left-0 w-[43%] rounded-full from-white to-emerald-500 opacity-35 blur\"></div>\n                                </div>\n                                <div className=\"flex items-center justify-between text-xs\">\n                                    <span className=\"text-muted-foreground\">550 / 1,500 tokens</span>\n                                    <span className=\"text-emerald-500\">950 left</span>\n                                </div>\n                            </div>\n\n                            <div className=\"grid grid-cols-2 gap-2 text-xs\">\n                                <div className=\"bg-muted/50 rounded-lg border p-2\">\n                                    <div className=\"text-muted-foreground\">Est. Cost</div>\n                                    <div className=\"text-foreground mt-0.5 font-medium\">$0.25</div>\n                                </div>\n                                <div className=\"bg-muted/50 rounded-lg border p-2\">\n                                    <div className=\"text-muted-foreground\">Requests</div>\n                                    <div className=\"text-foreground mt-0.5 font-medium\">48</div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/features-carousel/three/illustrations/translation-interface.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/translation-interface.tsx",
      "content": "export const TranslationInterface = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"min-w-xs max-w-xs\">\n            <div className=\"space-y-3\">\n                <div className=\"mask-y-from-35%\">\n                    <p className=\"text-sm/6\">Corporis voluptates voluptatem atque excepturi, tempore dolor distinctio libero dicta vel, nihil rem consequatur esse aspernatur nostrum, minus magnam labore quas optio?</p>\n                </div>\n\n                <div className=\"relative flex w-fit items-center gap-1\">\n                    <span className=\"bg-linear-to-r from-primary rounded to-emerald-500 bg-clip-text text-sm text-transparent dark:from-white dark:via-indigo-300\">Auto translated from English</span>\n                </div>\n\n                <div className=\"bg-illustration ring-primary/50 shadow-black/6.5 rounded-xl p-3 shadow-md ring-1\">\n                    <div className=\"text-muted-foreground mb-3 text-xs\">Spanish</div>\n\n                    <p className=\"text-foreground text-sm/6\">Hola, ¿cómo puedo ayudarte hoy? Estoy aquí para responder cualquier pregunta que tengas sobre nuestros servicios y productos.</p>\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/features-carousel/three/illustrations/workflow.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/workflow.tsx",
      "content": "import { Linear } from '@/components/ui/svgs/linear'\nimport { Vercel } from '@/components/ui/svgs/vercel'\nimport { CheckCircle2, GitBranch } from 'lucide-react'\n\nexport const Workflow = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"min-w-2xs max-w-2xs mx-auto\">\n            <div>\n                <div className=\"bg-illustration ring-border-illustration shadow-black/6.5 flex items-center gap-2 rounded-xl p-3 shadow-md ring-1\">\n                    <CheckCircle2 className=\"size-4 fill-emerald-500/15 text-emerald-500\" />\n                    <span className=\"text-foreground text-sm font-medium\">Workflow completed</span>\n                </div>\n                <div className=\"relative space-y-4 pl-6 pt-6\">\n                    <div className=\"border-foreground/15 absolute bottom-8 left-6 top-0 border-l border-dashed\"></div>\n                    <div className=\"relative pl-6\">\n                        <div className=\"border-foreground/15 absolute bottom-1/2 left-0 top-0 w-6 rounded-bl-full border-b border-l border-dashed\"></div>\n                        <div className=\"bg-card ring-border-illustration flex items-center gap-2 rounded-xl p-3 shadow ring-1\">\n                            <Linear className=\"size-3.5\" />\n                            <span className=\"text-muted-foreground text-xs font-medium\">\n                                Issue created <span className=\"text-foreground/50 pl-0.5 text-xs\">12s ago</span>\n                            </span>\n                        </div>\n                    </div>\n\n                    <div className=\"relative pl-6\">\n                        <div className=\"border-foreground/15 absolute bottom-1/2 left-0 top-0 w-6 rounded-bl-full border-b border-l border-dashed\"></div>\n                        <div className=\"bg-card ring-border-illustration flex items-center gap-2 rounded-xl p-3 shadow ring-1\">\n                            <GitBranch className=\"size-3.5\" />\n                            <span className=\"text-muted-foreground text-xs font-medium\">\n                                Branch created <span className=\"text-foreground/50 pl-0.5 text-xs\">3s ago</span>\n                            </span>\n                        </div>\n                    </div>\n\n                    <div className=\"relative pl-6\">\n                        <div className=\"border-foreground/15 absolute bottom-1/2 left-0 top-0 w-6 rounded-bl-full border-b border-l border-dashed\"></div>\n                        <div className=\"bg-card ring-border-illustration flex items-center gap-2 rounded-xl p-3 shadow ring-1\">\n                            <Vercel className=\"fill-foreground size-3.5\" />\n                            <span className=\"text-muted-foreground text-xs font-medium\">\n                                Preview deployed <span className=\"text-foreground/50 pl-0.5 text-xs\">now</span>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n\nexport default Workflow\n"
    }
  ]
}

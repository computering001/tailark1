  "files": [
    {
      "path": "blocks/expandable-features/twenty/index.tsx",
      "type": "registry:component",
      "target": "@components/expandable-features-20.tsx",
      "content": "'use client'\n\nimport { cn } from '@/lib/utils'\nimport { useState, useEffect, useCallback, useRef } from 'react'\nimport { Card } from '@/components/ui/card'\nimport { Brain, LassoSelect } from 'lucide-react'\nimport Kanban3 from '@/components/illustrations/kanban-3'\nimport Email from '@/components/illustrations/email'\n\nconst AUTOPLAY_DURATION = 7000\n\nexport default function ExpandableFeatures() {\n    const [expandedIndex, setExpandedIndex] = useState<number>(0)\n    const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null)\n\n    const resetTimer = useCallback(() => {\n        if (intervalRef.current) clearInterval(intervalRef.current)\n        intervalRef.current = setInterval(() => {\n            setExpandedIndex((current) => (current + 1) % 2)\n        }, AUTOPLAY_DURATION)\n    }, [])\n\n    useEffect(() => {\n        resetTimer()\n        return () => {\n            if (intervalRef.current) clearInterval(intervalRef.current)\n        }\n    }, [resetTimer])\n\n    const handleSelect = (index: number) => {\n        if (index === expandedIndex) return\n        setExpandedIndex(index)\n        resetTimer()\n    }\n\n    return (\n        <section className=\"bg-background @container py-24 max-lg:px-1\">\n            <div className=\"mx-auto max-w-5xl max-lg:px-6\">\n                <div className=\"mb-12 grid items-end gap-6 sm:mb-20 md:grid-cols-2 lg:gap-12\">\n                    <h2 className=\"text-foreground text-balance text-4xl font-semibold tracking-tight\">Ship with confidence using our unified platform</h2>\n                    <p className=\"text-muted-foreground text-balance text-lg\">Streamline your workflow with tools designed to enhance productivity at every step.</p>\n                </div>\n\n                <div className={cn('bg-foreground/10 grid gap-px rounded-2xl p-px transition-[grid-template-columns] duration-300 ease-in-out md:grid-cols-[2fr_1fr]', expandedIndex === 0 && 'md:grid-cols-[2fr_1fr]', expandedIndex === 1 && 'md:grid-cols-[1fr_2fr]')}>\n                    <Card\n                        data-expanded={expandedIndex === 0}\n                        className=\"bg-background shadow-black/4 relative overflow-hidden rounded-none text-left shadow-md ring-transparent max-md:rounded-t-[15px] md:rounded-l-[15px]\">\n                        <div className=\"sm:w-162 md:w-158 lg:w-162 grid h-full gap-3 sm:grid-cols-2\">\n                            <div className=\"flex h-full flex-col justify-between gap-12 py-8 pl-8\">\n                                <LassoSelect className=\"size-4\" />\n                                <div>\n                                    <button type=\"button\"\n                                        className=\"absolute inset-0 cursor-pointer\"\n                                        aria-label=\"extend smart email composition feature\"\n                                        onClick={() => handleSelect(0)}\n                                        aria-expanded={expandedIndex === 0}\n                                    />\n                                    <h3 className=\"text-foreground font-medium\">Smart email composition</h3>\n                                    <p className=\"text-muted-foreground mt-4 text-balance\">with AI-powered suggestions, templates, and seamless collaboration for faster communication.</p>\n                                </div>\n                            </div>\n                            <div className=\"overflow-hidden\">\n                                <div className=\"*:scale-95 sm:py-12\">\n                                    <Email />\n                                </div>\n                            </div>\n                        </div>\n                    </Card>\n                    <Card\n                        data-expanded={expandedIndex === 1}\n                        className=\"bg-background shadow-black/4 relative overflow-hidden rounded-none text-left shadow-md ring-transparent max-md:rounded-b-[15px] md:rounded-r-[15px]\">\n                        <div className=\"sm:w-162 md:w-158 lg:w-162 grid h-full gap-3 *:h-full sm:grid-cols-2\">\n                            <div className=\"flex flex-col justify-between gap-12 py-8 pl-8\">\n                                <Brain className=\"size-4\" />\n                                <div>\n                                    <button type=\"button\"\n                                        className=\"absolute inset-0 cursor-pointer\"\n                                        aria-label=\"extend smart email composition feature\"\n                                        onClick={() => handleSelect(1)}\n                                        aria-expanded={expandedIndex === 1}\n                                    />\n                                    <h3 className=\"text-foreground font-medium\">Visual task management</h3>\n                                    <p className=\"text-muted-foreground mt-4 text-balance\">Organize projects with drag-and-drop boards, priority flags, and real-time collaboration.</p>\n                                </div>\n                            </div>\n                            <div className=\"overflow-hidden\">\n                                <div className=\"*:origin-left *:scale-90 sm:py-6\">\n                                    <Kanban3 />\n                                </div>\n                            </div>\n                        </div>\n                    </Card>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/expandable-features/twenty/illustrations/email.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/email.tsx",
      "content": "import { Plus } from 'lucide-react'\nimport Image from 'next/image'\nconst SHADCN_AVATAR = 'https://avatars.githubusercontent.com/u/124599?v=4'\n\nexport const Email = () => (\n    <div\n        aria-hidden\n        className=\"mask-radial-[100%_100%] mask-radial-from-75% mask-radial-at-top-left min-w-xs relative pl-6 pt-1\">\n        <div className=\"bg-card ring-border-illustration rounded-2xl p-6 pb-16 pt-2 shadow-xl shadow-black/10 ring-1\">\n            <div className=\"divide-y border-b text-xs *:flex *:h-10 *:items-center *:py-2\">\n                <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-1\">\n                        <span className=\"text-foreground/50\">To:</span>\n                        <div className=\"bg-illustration ring-border-illustration shadow-black/6.5 flex cursor-pointer gap-1 rounded-full p-0.5 pr-2.5 shadow-md ring-1\">\n                            <div className=\"before:border-foreground/20 relative size-4 overflow-hidden rounded-full before:absolute before:inset-0 before:rounded-full before:border\">\n                                <Image\n                                    src={SHADCN_AVATAR}\n                                    alt=\"Shadcn\"\n                                    width={20}\n                                    height={20}\n                                />\n                            </div>\n                            <span className=\"text-xs font-medium\">Shadcn</span>\n                        </div>\n                    </div>\n                    <div className=\"bg-foreground/10 flex size-6 rounded-full border\">\n                        <Plus\n                            className=\"m-auto size-3.5\"\n                            strokeWidth={3}\n                        />\n                    </div>\n                </div>\n                <div className=\"flex gap-1\">\n                    <span className=\"text-foreground/50\">Cc:</span>\n                </div>\n                <div className=\"flex gap-1\">\n                    <span className=\"text-foreground/50\">Subject:</span>\n                </div>\n                <div className=\"flex gap-1\">\n                    <span className=\"text-foreground/50\">From:</span>\n                </div>\n            </div>\n            <div className=\"text-muted-foreground mt-6 space-y-2 text-sm/6\">\n                <p>\n                    Web applications with <span className=\"bg-linear-to-r from-primary rounded to-emerald-500 bg-clip-text px-0.5 text-transparent\">React and TypeScript</span> using best practices.\n                </p>\n                <p className=\"mt-3\">Sent from my iPhone</p>\n            </div>\n        </div>\n    </div>\n)\n\nexport default Email\n"
    },
    {
      "path": "blocks/expandable-features/twenty/illustrations/kanban-3.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/kanban-3.tsx",
      "content": "import { MoreHorizontal, Flag, MessageSquare, Paperclip } from 'lucide-react'\nimport Image from 'next/image'\n\nconst MESCHAC_AVATAR = 'https://avatars.githubusercontent.com/u/47919550?v=4'\nconst SHADCN_AVATAR = 'https://avatars.githubusercontent.com/u/124599?v=4'\n\nexport const Kanban3 = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"mask-radial-[100%_100%] mask-radial-from-75% mask-radial-at-top-left pl-6 pt-1\">\n            <div className=\"bg-card/50 ring-border-illustration shadow-black/6.5 min-w-xs rounded-2xl p-2 shadow-xl ring-1\">\n                <div className=\"mb-2 flex items-center justify-between px-2 pt-1\">\n                    <div className=\"flex items-center gap-2\">\n                        <div className=\"size-2 rounded-full bg-amber-500\" />\n                        <span className=\"text-sm font-semibold\">In Progress</span>\n                    </div>\n                    <MoreHorizontal className=\"text-muted-foreground size-4\" />\n                </div>\n\n                <div className=\"space-y-2 *:rounded-xl\">\n                    <div className=\"bg-illustration ring-border-illustration p-3 ring-1\">\n                        <div className=\"mb-2 flex items-start justify-between\">\n                            <div className=\"text-sm font-medium\">API Integration</div>\n                            <Flag className=\"size-3.5 fill-red-500 text-red-500\" />\n                        </div>\n                        <p className=\"text-muted-foreground mb-3 text-xs\">Connect payment gateway endpoints</p>\n                        <div className=\"flex items-center justify-between\">\n                            <div className=\"flex -space-x-1.5\">\n                                <div className=\"size-5 overflow-hidden rounded-full ring-2 ring-white dark:ring-gray-800\">\n                                    <Image\n                                        src={MESCHAC_AVATAR}\n                                        alt=\"Méschac Irung\"\n                                        width={20}\n                                        height={20}\n                                    />\n                                </div>\n                                <div className=\"size-5 overflow-hidden rounded-full ring-2 ring-white dark:ring-gray-800\">\n                                    <Image\n                                        src={SHADCN_AVATAR}\n                                        alt=\"Shadcn\"\n                                        width={20}\n                                        height={20}\n                                    />\n                                </div>\n                            </div>\n                            <div className=\"text-muted-foreground flex items-center gap-2 text-[10px]\">\n                                <span className=\"flex items-center gap-0.5\">\n                                    <MessageSquare className=\"size-3\" />4\n                                </span>\n                                <span className=\"flex items-center gap-0.5\">\n                                    <Paperclip className=\"size-3\" />2\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div className=\"bg-illustration ring-border-illustration p-3 ring-1\">\n                        <div className=\"mb-2 flex items-start justify-between\">\n                            <div className=\"text-sm font-medium\">User Testing</div>\n                            <Flag className=\"size-3.5 fill-amber-500 text-amber-500\" />\n                        </div>\n                        <p className=\"text-muted-foreground mb-3 text-xs\">Run usability tests with beta users</p>\n                        <div className=\"flex items-center justify-between\">\n                            <div className=\"flex -space-x-1.5\">\n                                <div className=\"size-5 overflow-hidden rounded-full ring-2 ring-white dark:ring-gray-800\">\n                                    <Image\n                                        src={SHADCN_AVATAR}\n                                        alt=\"Shadcn\"\n                                        width={20}\n                                        height={20}\n                                    />\n                                </div>\n                            </div>\n                            <div className=\"text-muted-foreground flex items-center gap-2 text-[10px]\">\n                                <span className=\"flex items-center gap-0.5\">\n                                    <MessageSquare className=\"size-3\" />2\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div className=\"bg-illustration ring-border-illustration p-3 ring-1\">\n                        <div className=\"mb-2 flex items-start justify-between\">\n                            <div className=\"text-sm font-medium\">Documentation</div>\n                            <Flag className=\"text-muted-foreground size-3.5\" />\n                        </div>\n                        <p className=\"text-muted-foreground mb-3 text-xs\">Write API reference docs</p>\n                        <div className=\"flex items-center justify-between\">\n                            <div className=\"flex -space-x-1.5\">\n                                <div className=\"size-5 overflow-hidden rounded-full ring-2 ring-white dark:ring-gray-800\">\n                                    <Image\n                                        src={MESCHAC_AVATAR}\n                                        alt=\"Méschac Irung\"\n                                        width={20}\n                                        height={20}\n                                    />\n                                </div>\n                            </div>\n                            <div className=\"text-muted-foreground flex items-center gap-2 text-[10px]\">\n                                <span className=\"flex items-center gap-0.5\">\n                                    <Paperclip className=\"size-3\" />1\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n\nexport default Kanban3\n"
    }
  ]
}

{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "expandable-features-20",
  "type": "registry:block",
  "title": "Expandable Features 20",
  "description": "Tailark expandable-features variant 20 block",
  "registryDependencies": [
    "@tailark/card",
    "@tailark/core-utils"
  ],

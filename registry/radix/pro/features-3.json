  "files": [
    {
      "path": "blocks/features/three/index.tsx",
      "type": "registry:component",
      "target": "@components/features-3.tsx",
      "content": "import { Message } from '@/components/illustrations/message'\nimport { Poll } from '@/components/illustrations/poll'\nimport { Uptime } from '@/components/illustrations/uptime'\n\nexport default function FeaturesSection() {\n    return (\n        <section className=\"bg-background @container py-24\">\n            <div className=\"mx-auto w-full max-w-5xl px-6\">\n                <div className=\"@max-4xl:max-w-sm ring-border verflow-hidden bg-card/50 mx-auto rounded-2xl border border-transparent shadow-md shadow-black/5 ring-1\">\n                    <div className=\"@4xl:grid-cols-3 @max-4xl:divide-y @4xl:divide-x grid\">\n                        <div className=\"row-span-2 grid grid-rows-subgrid gap-8 p-8\">\n                            <div className=\"mx-auto max-w-56 self-center\">\n                                <Message />\n                            </div>\n                            <div className=\"mx-auto max-w-sm text-center\">\n                                <h3 className=\"text-balance font-semibold\">Fast Messaging</h3>\n                                <p className=\"text-muted-foreground mt-3 text-balance\">Send and receive messages quickly and efficiently.</p>\n                            </div>\n                        </div>\n                        <div className=\"row-span-2 grid grid-rows-subgrid gap-8 p-8\">\n                            <div className=\"self-center\">\n                                <Uptime />\n                            </div>\n                            <div className=\"relative z-10 mx-auto max-w-sm text-center\">\n                                <h3 className=\"text-balance font-semibold\">Scan QR codes</h3>\n                                <p className=\"text-muted-foreground mt-3 text-balance\">Scan QR codes to access your polls and vote.</p>\n                            </div>\n                        </div>\n                        <div className=\"row-span-2 grid grid-rows-subgrid gap-8 p-8\">\n                            <div className=\"mx-auto self-center\">\n                                <Poll />\n                            </div>\n                            <div className=\"relative z-10 mx-auto max-w-sm text-center\">\n                                <h3 className=\"text-balance font-semibold\">Customizable polls</h3>\n                                <p className=\"text-muted-foreground mt-3 text-balance\">Create polls with custom questions, options, and voting methods.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/features/three/illustrations/message.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/message.tsx",
      "content": "import Image from 'next/image'\n\nconst MESCHAC_AVATAR = 'https://avatars.githubusercontent.com/u/47919550?v=4'\n\nexport const Message = () => (\n    <div aria-hidden>\n        <div className=\"flex items-center gap-2\">\n            <Image\n                src={MESCHAC_AVATAR}\n                className=\"size-4 rounded-full\"\n                alt=\"Méschac Irung\"\n                width=\"46\"\n                height=\"46\"\n            />\n            <span className=\"text-sm\">Irung</span>\n        </div>\n\n        <div className=\"bg-illustration ring-border-illustration mt-2 w-fit rounded-2xl rounded-tl border border-transparent p-3 text-sm shadow shadow-black/10 ring-1\">\n            Hey <span className=\"text-primary\">@bernard</span>, I've updated the dashboard metrics.\n        </div>\n    </div>\n)\n"
    },
    {
      "path": "blocks/features/three/illustrations/poll.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/poll.tsx",
      "content": "import Image from \"next/image\"\n\nexport const Poll = () => {\n  return (\n    <div aria-hidden className=\"relative w-full select-none\">\n      <div className=\"relative w-full space-y-2 py-4\">\n        <div className=\"absolute inset-y-0 left-0 w-px bg-[linear-gradient(180deg,var(--color-foreground)_1px,transparent_1px)] bg-size-[1px_4px] bg-repeat-y opacity-25\"></div>\n\n        <div className=\"pl-5\">\n          <div className=\"relative mt-0.5 inline-flex items-center gap-2 text-sm font-medium text-foreground before:absolute before:inset-y-0 before:left-[-22px] before:my-auto before:size-[5px] before:rounded-full before:border before:border-muted-foreground before:bg-background before:ring before:ring-background\">\n            <div className=\"text-xs text-muted-foreground\">06 AM</div>\n            Poll Created\n          </div>\n        </div>\n        <div className=\"relative -mx-5 flex rounded-xl border border-transparent bg-illustration py-1 pr-4 pl-2 text-xs shadow ring-1 shadow-black/10 ring-border-illustration\">\n          <div className=\"relative mt-0.5 ml-7 inline-flex items-center gap-2 text-sm font-medium before:absolute before:inset-y-0 before:left-[-19px] before:my-auto before:size-[5px] before:rounded-full before:border before:border-primary before:bg-background before:ring before:ring-background\">\n            <div className=\"flex items-center -space-x-2\">\n              {[\n                {\n                  src: \"https://avatars.githubusercontent.com/u/47919550?v=4\",\n                  alt: \"Méschac Irung\",\n                },\n                {\n                  src: \"https://avatars.githubusercontent.com/u/31113941?v=4\",\n                  alt: \"Bernard Ngandu\",\n                },\n              ].map((avatar, index) => (\n                <div\n                  key={index}\n                  className=\"size-6 rounded-full border bg-background p-0.5 shadow shadow-zinc-950/5 *:rounded-full\"\n                >\n                  <Image\n                    src={avatar.src}\n                    className=\"aspect-square rounded-[calc(var(--avatar-radius)-2px)] object-cover\"\n                    alt={avatar.alt}\n                    width=\"46\"\n                    height=\"46\"\n                  />\n                </div>\n              ))}\n            </div>\n            +50 Users voted\n          </div>\n        </div>\n        <div className=\"pl-5\">\n          <div className=\"relative mt-0.5 inline-flex items-center gap-2 text-sm font-medium text-foreground before:absolute before:inset-y-0 before:left-[-22px] before:my-auto before:size-[5px] before:rounded-full before:border before:border-muted-foreground before:bg-background before:ring before:ring-background\">\n            <div className=\"text-xs text-muted-foreground\">01 PM</div>\n            Poll Closed\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n"
    },
    {
      "path": "blocks/features/three/illustrations/uptime.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/uptime.tsx",
      "content": "export const Uptime = () => (\n    <div\n        aria-hidden\n        className=\"bg-illustration ring-border-illustration space-y-2.5 rounded-2xl border border-transparent p-4 shadow shadow-black/10 ring-1\">\n        <div className=\"flex justify-between text-sm\">\n            <span className=\"text-muted-foreground\">Uptime</span>\n            <span className=\"text-foreground\">99.9%</span>\n        </div>\n        <div className=\"mask-x-from-55% flex justify-between gap-px\">\n            {Array.from({ length: 40 }).map((_, index) => (\n                <div\n                    key={index}\n                    className=\"[:nth-child(10)]:bg-muted-foreground [:nth-child(11)]:bg-muted-foreground [:nth-child(22)]:bg-muted-foreground [:nth-child(23)]:bg-muted-foreground [:nth-child(24)]:bg-muted-foreground [:nth-child(32)]:bg-muted-foreground h-7 w-0.5 bg-emerald-500\"></div>\n            ))}\n        </div>\n    </div>\n)\n"
    }
  ]

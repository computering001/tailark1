{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "secondary-hero-8",
  "type": "registry:block",
  "title": "Secondary Hero 8",
  "description": "Tailark secondary-hero variant 8 block",
  "registryDependencies": [
    "@tailark/button"
  ],
  "meta": {
    "aspect-ratio": "80/41",
    "width": 686,

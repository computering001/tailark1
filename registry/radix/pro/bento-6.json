  "files": [
    {
      "path": "blocks/bento/six/index.tsx",
      "type": "registry:component",
      "target": "@components/bento-6.tsx",
      "content": "import { Card } from '@/components/ui/card'\nimport { Chart } from '@/components/illustrations/chart'\nimport { Kit } from '@/components/illustrations/kit'\nimport { Message } from '@/components/illustrations/message'\n\nexport default function BentoSix() {\n    return (\n        <section className=\"bg-background @container py-24\">\n            <div className=\"mx-auto w-full max-w-5xl px-6\">\n                <div className=\"@xl:grid-cols-2 @4xl:grid-cols-5 grid gap-3\">\n                    <div className=\"@4xl:col-span-2 space-y-3\">\n                        <Card className=\"grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n                            <div>\n                                <h3 className=\"text-foreground font-semibold\">Collaborative Analysis</h3>\n                                <p className=\"text-muted-foreground mt-2\">Add comments, share insights...</p>\n                            </div>\n                            <div aria-hidden>\n                                <Chart />\n                            </div>\n                        </Card>\n                        <Card className=\"grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n                            <div>\n                                <h3 className=\"text-foreground font-semibold\">Collaborative Analysis</h3>\n                                <p className=\"text-muted-foreground mt-2\">Add comments, share insights, and work together.</p>\n                            </div>\n                            <Message />\n                        </Card>\n                    </div>\n                    <Card className=\"@4xl:col-span-3 group grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n                        <div>\n                            <h3 className=\"text-foreground font-semibold\">Smart Lighting Control</h3>\n                            <p className=\"text-muted-foreground mt-2\">\n                                Automate your home lighting with customizable schedules and advanced <span className=\"text-foreground font-medium\">team collaboration features</span>.\n                            </p>\n                        </div>\n                        <Kit />\n                    </Card>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/six/illustrations/chart.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/chart.tsx",
      "content": "'use client'\nimport dynamic from 'next/dynamic'\nimport { type ChartConfig, ChartContainer, ChartTooltipContent } from '@/components/ui/chart'\n\nconst chartConfig = {\n    desktop: {\n        label: 'Desktop',\n        color: 'orange',\n    },\n    mobile: {\n        label: 'Mobile',\n        color: 'violet',\n    },\n} satisfies ChartConfig\n\nconst chartData = [\n    { month: 'May', desktop: 56, mobile: 224 },\n    { month: 'June', desktop: 56, mobile: 224 },\n    { month: 'January', desktop: 126, mobile: 252 },\n    { month: 'February', desktop: 205, mobile: 410 },\n    { month: 'March', desktop: 200, mobile: 126 },\n    { month: 'April', desktop: 400, mobile: 800 },\n]\n\ntype RechartsChartProps = import('react').ComponentProps<(typeof import('recharts'))['AreaChart']>\n\nconst RechartsChart = dynamic<RechartsChartProps>(() =>\n    import('recharts').then(({ Area, AreaChart, Tooltip, XAxis }) => {\n        function LoadedChart(props: RechartsChartProps) {\n            return (\n                <AreaChart\n                    {...props}\n                    accessibilityLayer\n                    data={chartData}\n                    margin={{\n                        left: 0,\n                        right: 0,\n                    }}>\n                    <defs>\n                        <linearGradient id=\"fillDesktop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.1} />\n                        </linearGradient>\n                        <linearGradient id=\"fillMobile\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.1} />\n                        </linearGradient>\n                    </defs>\n                    <Tooltip active content={<ChartTooltipContent className=\"dark:bg-muted\" />} />\n                    <XAxis dataKey=\"month\" stroke=\"var(--color-muted)\" />\n                    <Area strokeWidth={1} dataKey=\"mobile\" type=\"natural\" fill=\"url(#fillMobile)\" fillOpacity={0.1} stroke=\"var(--color-mobile)\" stackId=\"a\" />\n                    <Area strokeWidth={1} dataKey=\"desktop\" type=\"natural\" fill=\"url(#fillDesktop)\" fillOpacity={0.1} stroke=\"var(--color-desktop)\" stackId=\"a\" />\n                </AreaChart>\n            )\n        }\n\n        return LoadedChart\n    })\n)\n\nexport const Chart = () => {\n    return (\n        <ChartContainer className=\"-mb-4 aspect-auto h-28\" config={chartConfig}>\n            <RechartsChart />\n        </ChartContainer>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/six/illustrations/kit.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/kit.tsx",
      "content": "import { BookOpen, Gem, MoonStar } from \"lucide-react\"\n\nexport const Kit = () => {\n  return (\n    <div\n      aria-hidden\n      className=\"h-fit mask-b-from-55% px-6 perspective-dramatic\"\n    >\n      <div className=\"relative mx-auto mt-auto h-fit translate-x-4 -skew-x-4\">\n        <div className=\"absolute -bottom-6 left-0 z-10 h-64 w-3/4 overflow-hidden rounded-2xl border border-transparent bg-illustration/75 shadow-2xl ring-1 shadow-black/10 ring-border-illustration backdrop-blur\">\n          <div className=\"relative space-y-3 p-4\">\n            <div className=\"flex items-center gap-1.5\">\n              <svg\n                className=\"size-5\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"1em\"\n                height=\"1em\"\n                viewBox=\"0 0 32 32\"\n              >\n                <g fill=\"none\">\n                  <path\n                    fill=\"#ff6723\"\n                    d=\"M26 19.34c0 6.1-5.05 11.005-11.15 10.641c-6.269-.374-10.56-6.403-9.752-12.705c.489-3.833 2.286-7.12 4.242-9.67c.34-.445.689 3.136 1.038 2.742c.35-.405 3.594-6.019 4.722-7.991a.694.694 0 0 1 1.028-.213C18.394 3.854 26 10.277 26 19.34\"\n                  ></path>\n                  <path\n                    fill=\"#ffb02e\"\n                    d=\"M23 21.851c0 4.042-3.519 7.291-7.799 7.144c-4.62-.156-7.788-4.384-7.11-8.739C9.07 14.012 15.48 10 15.48 10S23 14.707 23 21.851\"\n                  ></path>\n                </g>\n              </svg>\n              <div className=\"text-sm font-medium\">Steps</div>\n            </div>\n            <div className=\"space-y-3\">\n              <div className=\"border-b border-white/10 pb-3 text-sm font-medium text-muted-foreground\">\n                This year, you're walking more on average{\" \"}\n                <span className=\"text-foreground\">than you did in 2023.</span>\n              </div>\n              <div className=\"space-y-3\">\n                <div className=\"space-y-1\">\n                  <div>\n                    <span className=\"align-baseline text-xl font-medium text-foreground\">\n                      8,081\n                    </span>{\" \"}\n                    <span className=\"text-placeholder text-xs\">Steps/day</span>\n                  </div>\n                  <div className=\"flex h-5 items-center rounded bg-linear-to-r from-indigo-600 to-purple-300 px-2 text-xs text-white\">\n                    2024\n                  </div>\n                </div>\n                <div className=\"space-y-1\">\n                  <div>\n                    <span className=\"align-baseline text-xl font-medium text-foreground\">\n                      5,412\n                    </span>{\" \"}\n                    <span className=\"text-placeholder text-xs\">Steps/day</span>\n                  </div>\n                  <div className=\"flex h-5 w-2/3 items-center rounded bg-white/20 px-2 text-xs text-white\">\n                    2023\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mx-auto h-80 w-3/4 rounded-2xl border border-border-illustration bg-card px-6 py-4\">\n          <div className=\"space-y-2\">\n            <div>Favorite Kits</div>\n            <div className=\"-mx-2 flex flex-col gap-0.5 *:cursor-pointer *:rounded-md *:p-2 *:hover:bg-muted\">\n              <div className=\"flex items-center gap-1\">\n                <QuartzKitLogo />\n                <div className=\"text-xs\">Quartz</div>\n                <div className=\"ml-auto text-xs text-muted-foreground\">Now</div>\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <DuskKitLogo />\n                <div className=\"text-xs\">Dusk</div>\n                <div className=\"ml-auto text-xs text-muted-foreground\">\n                  12h ago\n                </div>\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <MistKitLogo />\n                <div className=\"text-xs\">Mist</div>\n                <div className=\"ml-auto text-xs text-muted-foreground\">\n                  2 days ago\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nconst QuartzKitLogo = () => (\n  <div className=\"relative flex size-5 items-center justify-center rounded bg-linear-to-b from-amber-400 to-rose-500 shadow-md shadow-black/25 before:absolute before:inset-px before:rounded-[3px] before:border before:border-white/40 before:ring-1 before:ring-black/25 dark:before:border-transparent dark:before:ring-white/25\">\n    <div className=\"absolute inset-x-px inset-y-1.5 border-y border-dotted border-white/25\"></div>\n    <div className=\"absolute inset-x-1.5 inset-y-px border-x border-dotted border-white/25\"></div>\n    <Gem className=\"size-3 fill-white stroke-white drop-shadow\" />\n  </div>\n)\n\nconst DuskKitLogo = () => (\n  <div className=\"relative flex size-5 items-center justify-center rounded border border-background bg-linear-to-b from-purple-300 to-blue-600 shadow-md ring-1 shadow-black/20 ring-black/10 dark:border-0 dark:inset-shadow-2xs dark:inset-ring dark:shadow-white/10 dark:ring-black/50 dark:inset-shadow-white/25 dark:inset-ring-white/25\">\n    <div className=\"absolute inset-x-0 inset-y-1.5 border-y border-dotted border-white/25\"></div>\n    <div className=\"absolute inset-x-1.5 inset-y-0 border-x border-dotted border-white/25\"></div>\n    <MoonStar className=\"size-3 fill-white stroke-white drop-shadow\" />\n  </div>\n)\n\nconst MistKitLogo = () => (\n  <div className=\"relative flex size-5 items-center justify-center rounded border border-background bg-linear-to-b from-lime-300 to-teal-600 shadow-md ring-1 shadow-black/20 ring-black/10 dark:border-0 dark:inset-shadow-2xs dark:inset-ring dark:shadow-white/10 dark:ring-black/50 dark:inset-shadow-white/25 dark:inset-ring-white/25\">\n    <div className=\"absolute inset-1 aspect-square rounded-full border border-white/35 bg-black/15\"></div>\n    <div className=\"absolute inset-px aspect-square rounded-full border border-dashed border-white/25\"></div>\n    <BookOpen className=\"size-3 fill-white stroke-white drop-shadow-sm\" />\n  </div>\n)\n"
    },
    {
      "path": "blocks/bento/six/illustrations/message.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/message.tsx",
      "content": "import Image from 'next/image'\n\nconst SHADCN_AVATAR = 'https://avatars.githubusercontent.com/u/124599?v=4'\n\nexport const Message = () => (\n    <div aria-hidden>\n        <div className=\"flex items-center gap-2\">\n            <div className=\"before:border-foreground/10 relative size-5 before:absolute before:inset-0 before:rounded-full before:border\">\n                <Image\n                    src={SHADCN_AVATAR}\n                    className=\"size-full rounded-full object-cover\"\n                    alt=\"Meschac\"\n                    loading=\"lazy\"\n                    width={460}\n                    height={460}\n                />\n            </div>\n            <span className=\"text-xs font-medium\">\n                Shadcn <span className=\"ml-1 opacity-65\">12m ago</span>\n            </span>\n        </div>\n\n        <div className=\"bg-linear-to-b ring-foreground/10 from-illustration shadow-black/6.5 to-foreground/5 mt-2 w-fit rounded-2xl rounded-tl p-3 text-sm shadow-md ring-1\">\n            Hey <span className=\"text-primary\">@bernard</span>, I've updated the dashboard metrics.\n        </div>\n    </div>\n)\n"
    }
  ]
}

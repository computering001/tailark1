      "content": "import { Button } from '@/components/ui/button'\nimport Link from 'next/link'\nimport { Card } from '@/components/ui/card'\nimport { Layout } from '@/components/illustrations/layout'\n\nexport default function CallToAction() {\n    return (\n        <section className=\"bg-background py-12 md:py-24\">\n            <div className=\"mx-auto max-w-5xl px-6\">\n                <Card className=\"relative overflow-hidden pl-8 pt-8 shadow-lg md:p-20\">\n                    <div className=\"max-w-xl max-md:pr-8\">\n                        <div className=\"relative\">\n                            <h2 className=\"text-foreground text-balance text-3xl font-semibold md:text-4xl tracking-tight\">Create, Sell and Grow</h2>\n                            <p className=\"text-muted-foreground mb-6 mt-4 text-balance\">Join a community of over 1000+ companies and developers who have already discovered the power of Tailark. </p>\n\n                            <Button asChild>\n                                <Link href=\"#\">Contact Sales</Link>\n                            </Button>\n                        </div>\n                    </div>\n                    <div className=\"max-lg:mask-b-from-35% max-lg:pt-6 max-md:mt-4 lg:absolute lg:inset-0 lg:top-12 lg:ml-auto lg:w-2/5\">\n                        <Layout />\n                    </div>\n                </Card>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/call-to-action/two/illustrations/layout.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/layout.tsx",
      "content": "export const Layout = () => (\n    <div\n        aria-hidden\n        className=\"relative\">\n        <div className=\"z-1 bg-card absolute -right-6 -top-6 bottom-0 left-[13rem] rounded-xl border shadow-xl\"></div>\n\n        <div className=\"mask-b-from-50% rounded-xl border\">\n            <div className=\"absolute inset-y-0 left-0 w-[12rem] border-r\">\n                <div className=\"flex gap-1.5 px-4 pt-4\">\n                    <div className=\"bg-foreground/5 border-foreground/5 size-2 rounded-full border\"></div>\n                    <div className=\"bg-foreground/5 border-foreground/5 size-2 rounded-full border\"></div>\n                    <div className=\"bg-foreground/5 border-foreground/5 size-2 rounded-full border\"></div>\n                </div>\n            </div>\n            <div className=\"ml-auto w-[calc(100%-12rem)]\">\n                <div className=\"h-11 border-b\"></div>\n                <div className=\"relative h-80\">\n                    <div className=\"absolute inset-0 bg-[repeating-linear-gradient(-45deg,var(--color-border),var(--color-border)_1px,transparent_1px,transparent_6px)] opacity-50\"></div>\n                </div>\n            </div>\n        </div>\n    </div>\n)\n"

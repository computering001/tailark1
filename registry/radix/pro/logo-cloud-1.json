  "title": "Logo Cloud 1",
  "description": "Tailark logo-cloud variant 1 block",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [
    "@tailark/core-beacon",
    "@tailark/core-bolt",
    "@tailark/core-cisco",
    "@tailark/core-hulu",
    "@tailark/core-leap-wallet",
    "@tailark/core-open-ai",
    "@tailark/core-paypal",
    "@tailark/core-polars",
    "@tailark/core-prime",
    "@tailark/core-spotify",
    "@tailark/core-stripe",
    "@tailark/core-supabase",
    "@tailark/core-vercel"
  ],
  "meta": {

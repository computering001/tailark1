    {
      "path": "blocks/bento/eight/index.tsx",
      "type": "registry:component",
      "target": "@components/bento-8.tsx",
      "content": "import { Card } from \"@/components/ui/card\"\nimport { AiMemory } from \"@/components/illustrations/ai-memory\"\nimport { Campaign } from \"@/components/illustrations/campaign\"\nimport { Chart } from \"@/components/illustrations/chart\"\nimport { Fingerprint } from \"@/components/illustrations/finger-print\"\nimport { Message } from \"@/components/illustrations/message\"\nimport { Models2 } from \"@/components/illustrations/models-2\"\n\nexport default function BentoEight() {\n  return (\n    <section className=\"@container bg-background py-24\">\n      <div className=\"mx-auto w-full max-w-5xl px-6 xl:px-0\">\n        <div className=\"grid gap-3 @xl:grid-cols-2 @4xl:grid-cols-3 @4xl:grid-rows-2\">\n          <div className=\"row-span-2 grid grid-rows-[auto_1fr] gap-4\">\n            <Card className=\"group grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n              <div>\n                <h3 className=\"font-semibold text-foreground\">\n                  Smart Home Automation\n                </h3>\n                <p className=\"mt-2 text-muted-foreground\">\n                  Control your entire home with{\" \"}\n                  <span className=\"font-medium text-foreground\">\n                    intelligent ecosystem\n                  </span>\n                  .\n                </p>\n              </div>\n              <div className=\"-mx-8 overflow-hidden\">\n                <AiMemory />\n              </div>\n            </Card>\n            <Card className=\"group grid grid-cols-[auto_1fr] gap-4 gap-6 overflow-hidden rounded-2xl p-8\">\n              <Fingerprint />\n              <div>\n                <h3 className=\"font-semibold text-foreground\">\n                  Biometric Access\n                </h3>\n                <p className=\"mt-2 text-muted-foreground\">\n                  Secure entry with fingerprint recognition\n                </p>\n              </div>\n            </Card>\n          </div>\n          <Card className=\"grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n            <div aria-hidden className=\"flex flex-col justify-end\">\n              <h3 className=\"font-semibold text-foreground\">\n                Marketing Campaigns\n              </h3>\n              <p className=\"mt-2 text-muted-foreground\">\n                Launch targeted promotions{\" \"}\n                <span className=\"font-medium text-foreground\">\n                  across channels\n                </span>\n                .\n              </p>\n            </div>\n            <div aria-hidden className=\"flex flex-col justify-end\">\n              <Campaign />\n            </div>\n          </Card>\n          <Card className=\"grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n            <div>\n              <h3 className=\"font-semibold text-foreground\">Team Messaging</h3>\n              <p className=\"mt-2 text-muted-foreground\">\n                Real-time communication for seamless collaboration.\n              </p>\n            </div>\n            <div aria-hidden className=\"flex flex-col justify-end\">\n              <Message />\n            </div>\n          </Card>\n          <Card className=\"grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n            <div>\n              <h3 className=\"font-semibold text-foreground\">\n                Data Visualization\n              </h3>\n              <p className=\"mt-2 text-muted-foreground\">\n                Transform complex data into clear, actionable insights.\n              </p>\n            </div>\n            <div aria-hidden className=\"flex flex-col justify-end\">\n              <Chart />\n            </div>\n          </Card>\n          <Card className=\"grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8\">\n            <div>\n              <h3 className=\"font-semibold text-foreground\">\n                Customer Feedback\n              </h3>\n              <p className=\"mt-2 text-muted-foreground\">\n                Collect and analyze user opinions to improve products.\n              </p>\n            </div>\n            <div\n              aria-hidden\n              className=\"-mx-8 flex flex-col justify-end overflow-hidden\"\n            >\n              <Models2 />\n            </div>\n          </Card>\n        </div>\n      </div>\n    </section>\n  )\n}\n"
    },
    {
      "path": "blocks/bento/eight/illustrations/ai-memory.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/ai-memory.tsx",
      "content": "import { Clock, MessageSquare } from \"lucide-react\"\n\nexport const AiMemory = () => {\n  return (\n    <div aria-hidden className=\"min-w-xs\">\n      <div className=\"flex flex-col gap-4 perspective-dramatic\">\n        <div className=\"-rotate-4 rotate-x-5 rotate-z-6 mask-radial-[100%_100%] mask-radial-from-75% mask-radial-at-top-left pt-1 pl-6\">\n          <div className=\"rounded-2xl bg-background/75 p-2 shadow-lg ring-1 shadow-black/6.5 ring-border-illustration\">\n            <div className=\"flex items-center gap-2 px-4 py-3\">\n              <div className=\"text-sm font-medium\">AI Memory</div>\n              <div className=\"ml-auto rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary\">\n                Active\n              </div>\n            </div>\n            <div className=\"rounded-xl bg-card p-4 ring-1 ring-border-illustration\">\n              <div className=\"space-y-3\">\n                <div className=\"text-xs text-muted-foreground\">\n                  Context Window\n                </div>\n\n                <div className=\"relative h-3 overflow-hidden rounded-full bg-muted\">\n                  <div className=\"absolute inset-y-0 left-0 w-[30%] rounded-full bg-primary/40\" />\n                  <div className=\"absolute inset-y-0 left-[30%] w-[45%] rounded-full bg-primary\" />\n                  <div className=\"absolute inset-0 flex items-center justify-center text-[8px] font-medium text-white\">\n                    12K / 16K tokens\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"mt-4 space-y-3\">\n                <div className=\"text-xs text-muted-foreground\">\n                  Remembered Context\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex items-center gap-2 rounded-lg bg-purple-500/10 p-2 ring-1 ring-purple-500/20\">\n                    <MessageSquare className=\"size-3.5 shrink-0 text-purple-600 dark:text-purple-400\" />\n                    <div className=\"flex-1 truncate text-[10px]\">\n                      User prefers dark mode UI\n                    </div>\n                    <Clock className=\"size-2.5 shrink-0 text-muted-foreground\" />\n                    <span className=\"text-[10px] text-muted-foreground\">\n                      2m\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 rounded-lg bg-blue-500/10 p-2 ring-1 ring-blue-500/20\">\n                    <MessageSquare className=\"size-3.5 shrink-0 text-blue-600 dark:text-blue-400\" />\n                    <div className=\"flex-1 truncate text-[10px]\">\n                      Working on a React project\n                    </div>\n                    <Clock className=\"size-2.5 shrink-0 text-muted-foreground\" />\n                    <span className=\"text-[10px] text-muted-foreground\">\n                      5m\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 rounded-lg bg-cyan-500/10 p-2 ring-1 ring-cyan-500/20\">\n                    <MessageSquare className=\"size-3.5 shrink-0 text-cyan-600 dark:text-cyan-400\" />\n                    <div className=\"flex-1 truncate text-[10px]\">\n                      Asked about authentication best practices\n                    </div>\n                    <Clock className=\"size-2.5 shrink-0 text-muted-foreground\" />\n                    <span className=\"text-[10px] text-muted-foreground\">\n                      8m\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"mt-3 flex items-center justify-between text-xs\">\n                <div className=\"text-muted-foreground\">\n                  3 conversations stored\n                </div>\n                <div className=\"text-primary hover:underline\">\n                  Clear\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default AiMemory\n"
    },
    {
      "path": "blocks/bento/eight/illustrations/campaign.tsx",

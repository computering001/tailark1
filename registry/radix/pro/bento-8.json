      "target": "@components/illustrations/campaign.tsx",
      "content": "export const Campaign = () => (\n    <div aria-hidden>\n        <div className=\"mb-4 flex gap-2 text-sm\">\n            <span className=\"opacity-75\">Loyalty program</span>\n            <span className=\"text-muted-foreground\">loyalty program</span>\n        </div>\n        <div className=\"@sm:grid-cols-2 grid gap-2 text-xs\">\n            <div className=\"bg-illustration ring-border-illustration shadow-black/6.5 flex gap-2 rounded-md border border-transparent p-1.5 shadow ring-1\">\n                <div className=\"bg-primary w-1 rounded-full\" />\n\n                <div>\n                    <div className=\"text-sm font-medium\">Start Date</div>\n                    <div className=\"text-muted-foreground line-clamp-1\">Feb 6, 2024 at 00:00</div>\n                </div>\n            </div>\n            <div className=\"bg-illustration ring-border-illustration shadow-black/6.5 flex gap-2 rounded-md border border-transparent p-1.5 shadow ring-1\">\n                <div className=\"bg-primary w-1 rounded-full\" />\n\n                <div>\n                    <div className=\"text-sm font-medium\">Start Date</div>\n                    <div className=\"text-muted-foreground line-clamp-1\">Feb 6, 2024 at 00:00</div>\n                </div>\n            </div>\n        </div>\n    </div>\n)\n\nexport default Campaign\n"
    },
    {
      "path": "blocks/bento/eight/illustrations/chart.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/chart.tsx",
      "content": "'use client'\nimport dynamic from 'next/dynamic'\nimport { type ChartConfig, ChartContainer, ChartTooltipContent } from '@/components/ui/chart'\n\nconst chartConfig = {\n    desktop: {\n        label: 'Desktop',\n        color: 'var(--color-primary)',\n    },\n    mobile: {\n        label: 'Mobile',\n        color: 'var(--color-indigo-300)',\n    },\n} satisfies ChartConfig\n\nconst chartData = [\n    { month: 'May', desktop: 56, mobile: 224 },\n    { month: 'June', desktop: 56, mobile: 224 },\n    { month: 'January', desktop: 126, mobile: 252 },\n    { month: 'February', desktop: 205, mobile: 410 },\n    { month: 'March', desktop: 200, mobile: 126 },\n    { month: 'April', desktop: 400, mobile: 800 },\n]\n\ntype RechartsChartProps = import('react').ComponentProps<(typeof import('recharts'))['AreaChart']>\n\nconst RechartsChart = dynamic<RechartsChartProps>(() =>\n    import('recharts').then(({ Area, AreaChart, Tooltip, XAxis }) => {\n        function LoadedChart(props: RechartsChartProps) {\n            return (\n                <AreaChart\n                    {...props}\n                    accessibilityLayer\n                    data={chartData}\n                    margin={{\n                        left: 0,\n                        right: 0,\n                    }}>\n                    <defs>\n                        <linearGradient id=\"fillDesktop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.1} />\n                        </linearGradient>\n                        <linearGradient id=\"fillMobile\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.1} />\n                        </linearGradient>\n                    </defs>\n                    <Tooltip active content={<ChartTooltipContent className=\"dark:bg-muted\" />} />\n                    <XAxis dataKey=\"month\" stroke=\"var(--color-muted)\" />\n                    <Area strokeWidth={1} dataKey=\"mobile\" type=\"natural\" fill=\"url(#fillMobile)\" fillOpacity={0.1} stroke=\"var(--color-mobile)\" stackId=\"a\" />\n                    <Area strokeWidth={1} dataKey=\"desktop\" type=\"natural\" fill=\"url(#fillDesktop)\" fillOpacity={0.1} stroke=\"var(--color-desktop)\" stackId=\"a\" />\n                </AreaChart>\n            )\n        }\n\n        return LoadedChart\n    })\n)\n\nexport const Chart = () => {\n    return (\n        <ChartContainer className=\"-mb-4 aspect-auto h-36\" config={chartConfig}>\n            <RechartsChart />\n        </ChartContainer>\n    )\n}\n"
    },

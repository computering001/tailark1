{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "forgot-password-2",
  "type": "registry:block",
  "title": "Forgot Password 2",
  "description": "Tailark forgot-password variant 2 block",
  "registryDependencies": [
    "@tailark/button",
    "@tailark/input",
    "@tailark/label",
    "@tailark/core-logo"
  ],
  "meta": {
    "aspect-ratio": "90/60",
    "width": 686,
    "height": 457,
    "category-media": true,
    "description": "Forgot-password flows happen when the user is already blocked. The page should reduce stress, avoid leaking account existence, and make the next step obvious."
  },
  "files": [
    {
      "path": "blocks/forgot-password/two/index.tsx",
      "type": "registry:component",
      "target": "@components/forgot-password-2.tsx",
      "content": "import { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\nimport { Button } from '@/components/ui/button'\nimport { LogoIcon } from \"@/components/ui/logo\"\n\nimport Link from 'next/link'\nimport { ArrowLeft } from 'lucide-react'\n\nexport default function ForgotPassword() {\n    return (\n        <main className=\"bg-background\">\n            <div className=\"flex min-h-dvh flex-col items-center justify-center gap-6 p-6 lg:col-span-2\">\n                <div className=\"m-auto max-w-xs\">\n                    <Link\n                        href=\"#\"\n                        aria-label=\"go home\"\n                        className=\"-ml-2.5 flex size-10 *:m-auto\">\n                        <LogoIcon className=\"size-7\" />\n                    </Link>\n\n                    <div className=\"mb-10 mt-6 space-y-2\">\n                        <h1 className=\"text-xl font-semibold\">Forgot Password?</h1>\n                        <p className=\"text-muted-foreground text-sm\">Enter your email and we'll send you a reset link</p>\n                    </div>\n\n                    <div className=\"space-y-5\">\n                        <form\n                            action=\"\"\n                            className=\"space-y-5\">\n                            <div className=\"space-y-2.5\">\n                                <Label\n                                    className=\"block text-left\"\n                                    htmlFor=\"email\">\n                                    Email\n                                </Label>\n                                <Input\n                                    type=\"email\"\n                                    id=\"email\"\n                                    required\n                                    placeholder=\"Enter your email\"\n                                    className=\"w-full\"\n                                />\n                            </div>\n                            <Button\n                                type=\"submit\"\n                                className=\"w-full\">\n                                Send Reset Link\n                            </Button>\n                        </form>\n\n                        <div className=\"text-muted-foreground pt-5 text-sm\">\n                            <Link\n                                href=\"#\"\n                                className=\"text-primary inline-flex items-center gap-1 font-medium hover:underline\">\n                                <ArrowLeft className=\"size-4\" />\n                                Back to Sign in\n                            </Link>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"mx-auto mt-auto w-full border-t pt-6\">\n                    <div className=\"mx-auto flex max-w-xs items-center justify-center gap-6\">\n                        <Link\n                            href=\"#\"\n                            className=\"text-muted-foreground hover:text-foreground text-sm\">\n                            Privacy\n                        </Link>\n                        <Link\n                            href=\"#\"\n                            className=\"text-muted-foreground hover:text-foreground text-sm\">\n                            Terms\n                        </Link>\n                        <Link\n                            href=\"#\"\n                            className=\"text-muted-foreground hover:text-foreground text-sm\">\n                            Cookies\n                        </Link>\n                    </div>\n                </div>\n            </div>\n        </main>\n    )\n}\n"
    }
  ]
}

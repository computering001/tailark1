  "files": [
    {
      "path": "blocks/bento/eleven/index.tsx",
      "type": "registry:component",
      "target": "@components/bento-11.tsx",
      "content": "import { AddComment } from \"@/components/illustrations/add-comment\"\nimport { Document } from \"@/components/illustrations/document\"\nimport { Currency } from \"@/components/illustrations/currency\"\nimport { Schedule } from \"@/components/illustrations/schedule\"\nimport Image from \"next/image\"\n\nconst GLODIE_AVATAR = \"https://avatars.githubusercontent.com/u/99137927?v=4\"\n\nexport default function BentoEleven() {\n  return (\n    <section className=\"@container bg-background py-24\">\n      <div className=\"mx-auto max-w-5xl px-6\">\n        <div className=\"border *:p-8 @3xl:grid @3xl:grid-cols-2 @3xl:*:p-12\">\n          <div className=\"row-span-2 grid grid-rows-subgrid gap-8 border-b @3xl:gap-12 @3xl:border-r\">\n            <div>\n              <h3 className=\"text-xl font-semibold text-foreground\">\n                Financial Analytics\n              </h3>\n              <p className=\"mt-4 text-lg text-muted-foreground\">\n                Track your financial performance with powerful visualizations.\n                Monitor cash flow, revenue trends, and expense patterns in\n                real-time.\n              </p>\n            </div>\n            <Currency />\n          </div>\n          <div className=\"row-span-2 grid grid-rows-subgrid gap-8 border-b @3xl:gap-12\">\n            <div>\n              <h3 className=\"text-xl font-semibold text-foreground\">\n                Document Management\n              </h3>\n              <p className=\"mt-4 text-lg text-muted-foreground\">\n                Organize, store, and access all your important documents\n                securely. Streamline your workflow with powerful search.\n              </p>\n            </div>\n            <div className=\"relative flex gap-4\">\n              <Document />\n              <Document />\n              <Document />\n            </div>\n          </div>\n          <div className=\"col-span-2 border-y border-background\">\n            <blockquote className=\"max-w-xl\">\n              <p className=\"text-lg sm:text-xl\">\n                Using TailsUI has been like unlocking a secret design\n                superpower. It's the perfect fusion of simplicity and\n                versatility, enabling us to create UIs that are as stunning as\n                they are user-friendly.\n              </p>\n\n              <div className=\"mt-6 flex items-center gap-2\">\n                <div className=\"size-7 rounded-full border bg-background p-0.5 shadow shadow-zinc-950/5\">\n                  <Image\n                    className=\"aspect-square rounded-full object-cover\"\n                    src={GLODIE_AVATAR}\n                    alt=\"Glodie\"\n                    height=\"52\"\n                    width=\"52\"\n                  />\n                </div>\n                <span>Glodie Lukose</span>\n                <span className=\"text-muted-foreground\">@glodie</span>\n              </div>\n            </blockquote>\n          </div>\n          <div className=\"row-span-2 grid grid-rows-subgrid gap-8 border-t @3xl:gap-12 @3xl:border-r\">\n            <div>\n              <h3 className=\"text-xl font-semibold text-foreground\">\n                Team Collaboration\n              </h3>\n              <p className=\"mt-4 text-lg text-muted-foreground\">\n                Foster seamless communication within your team. Add comments,\n                assign tasks, and keep everyone aligned on project goals.\n              </p>\n            </div>\n            <AddComment className=\"self-end pl-6\" />\n          </div>\n          <div className=\"row-span-2 grid grid-rows-subgrid gap-8 border-t @3xl:gap-12\">\n            <div>\n              <h3 className=\"text-xl font-semibold text-foreground\">\n                Smart Scheduling\n              </h3>\n              <p className=\"mt-4 text-lg text-muted-foreground\">\n                Plan your workday efficiently with intelligent scheduling tools.\n                Automate appointments and receive timely reminders for important\n                events.\n              </p>\n            </div>\n            <Schedule className=\"self-end pl-9\" />\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n"
    },
    {
      "path": "blocks/bento/eleven/illustrations/add-comment.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/add-comment.tsx",
      "content": "import { cn } from \"@/lib/utils\"\nimport Image from \"next/image\"\n\nconst SHADCN_AVATAR = \"https://avatars.githubusercontent.com/u/124599?v=4\"\n\nexport const AddComment = ({\n  className,\n}: {\n  className?: string\n}) => {\n  return (\n    <div aria-hidden className={cn(\"relative mt-8\", className)}>\n      <div\n        className={cn(\n          \"absolute flex h-10 -translate-x-1/8 translate-y-[-110%] items-center gap-3 rounded-lg bg-illustration py-1 pr-12 pl-2\",\n          \"border border-transparent shadow-lg ring-1 shadow-black/6.5 ring-border-illustration\"\n        )}\n      >\n        <div className=\"relative size-6 overflow-hidden rounded-full shadow-md before:absolute before:inset-0 before:rounded-full before:border before:border-foreground/20\">\n          <Image\n            className=\"aspect-square rounded-full object-cover\"\n            src={SHADCN_AVATAR}\n            alt=\"Shadcn\"\n            height=\"60\"\n            width=\"60\"\n          />\n        </div>\n        <span className=\"block text-sm text-muted-foreground\">\n          Add a comment...\n        </span>\n      </div>\n      <span className=\"text-muted-foreground\">\n        <span className=\"border-b-2 border-primary py-1 text-primary\">\n          Tomorrow 8:30 pm\n        </span>{\" \"}\n        is our highest priority.\n      </span>\n    </div>\n  )\n}\n"
    },
    {
      "path": "blocks/bento/eleven/illustrations/currency.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/currency.tsx",
      "content": "import { Bitcoin, DollarSign, Euro, Signature } from 'lucide-react'\n\nexport const Currency = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"flex -space-x-4\">\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-blue-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-blue-900 dark:text-blue-300\">\n                    <Bitcoin className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">BTC</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-green-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-green-900 dark:text-green-300\">\n                    <DollarSign className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">USD</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-red-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-red-900 dark:text-red-300\">\n                    <Euro className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">EURO</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/eleven/illustrations/document.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/document.tsx",
      "content": "import { Signature } from \"lucide-react\"\nimport { cn } from \"@/lib/utils\"\n\nexport const Document = ({ className }: { className?: string }) => {\n  return (\n    <div\n      className={cn(\n        \"w-16 space-y-2 rounded-md bg-illustration p-2 shadow-md ring-1 shadow-black/6.5 ring-border-illustration [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)]\",\n        className\n      )}\n    >\n      <div className=\"flex items-center gap-1\">\n        <div className=\"size-2.5 rounded-full bg-foreground/15\"></div>\n        <div className=\"h-[3px] w-4 rounded-full bg-foreground/15\"></div>\n      </div>\n      <div className=\"space-y-1.5\">\n        <div className=\"flex items-center gap-1\">\n          <div className=\"h-[3px] w-2.5 rounded-full bg-foreground/15\"></div>\n          <div className=\"h-[3px] w-6 rounded-full bg-foreground/15\"></div>\n        </div>\n        <div className=\"flex items-center gap-1\">\n          <div className=\"h-[3px] w-2.5 rounded-full bg-foreground/15\"></div>\n          <div className=\"h-[3px] w-6 rounded-full bg-foreground/15\"></div>\n        </div>\n      </div>\n\n      <div className=\"space-y-1.5\">\n        <div className=\"h-[3px] w-full rounded-full bg-foreground/15\"></div>\n        <div className=\"flex items-center gap-1\">\n          <div className=\"h-[3px] w-2/3 rounded-full bg-foreground/15\"></div>\n          <div className=\"h-[3px] w-1/3 rounded-full bg-foreground/15\"></div>\n        </div>\n      </div>\n\n      <Signature className=\"ml-auto size-3\" />\n    </div>\n  )\n}\n"
    },
    {
      "path": "blocks/bento/eleven/illustrations/schedule.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/schedule.tsx",
      "content": "import { cn } from \"@/lib/utils\"\nimport { buttonVariants } from \"@/components/ui/button\"\nimport {\n  ToggleGroup,\n  ToggleGroupItem,\n} from \"@/components/ui/toggle-group\"\nimport {\n  Calendar1,\n  Bold,\n  Italic,\n  Strikethrough,\n  Underline,\n  Ellipsis,\n} from \"lucide-react\"\n\nexport const Schedule = ({ className }: { className?: string }) => {\n  return (\n    <div aria-hidden className={cn(\"relative pt-8\", className)}>\n      <div\n        className={cn(\n          \"absolute flex -translate-x-1/8 translate-y-[-110%] items-center gap-2 rounded-xl border border-foreground/10 bg-background p-1 shadow-md shadow-black/6.5\"\n        )}\n      >\n        <div\n          className={buttonVariants({\n            size: \"sm\",\n            variant: \"default\",\n            className: \"ml-0.5 [--color-primary-foreground:var(--color-white)]\",\n          })}\n        >\n          <Calendar1 className=\"size-3\" />\n          <span className=\"text-sm font-medium\">Schedule</span>\n        </div>\n        <span className=\"block h-4 w-px bg-border\"></span>\n        <ToggleGroup type=\"multiple\" size=\"sm\" className=\"gap-0.5 *:rounded-md\">\n          <ToggleGroupItem value=\"bold\" aria-label=\"Toggle bold\">\n            <Bold className=\"size-4\" />\n          </ToggleGroupItem>\n          <ToggleGroupItem value=\"italic\" aria-label=\"Toggle italic\">\n            <Italic className=\"size-4\" />\n          </ToggleGroupItem>\n          <ToggleGroupItem value=\"underline\" aria-label=\"Toggle underline\">\n            <Underline className=\"size-4\" />\n          </ToggleGroupItem>\n          <ToggleGroupItem\n            value=\"strikethrough\"\n            aria-label=\"Toggle strikethrough\"\n          >\n            <Strikethrough className=\"size-4\" />\n          </ToggleGroupItem>\n        </ToggleGroup>\n        <span className=\"block h-4 w-px bg-border\" />\n        <div\n          className={buttonVariants({\n            size: \"icon\",\n            variant: \"ghost\",\n          })}\n        >\n          <Ellipsis className=\"size-3\" />\n        </div>\n      </div>\n      <span>\n        <span className=\"bg-primary/10 py-1 font-medium text-primary\">\n          Tomorrow 8:30 pm\n        </span>{\" \"}\n        is our priority.\n      </span>\n    </div>\n  )\n}\n"
    }
  ]
}

  "files": [
    {
      "path": "blocks/features/nine/index.tsx",
      "type": "registry:component",
      "target": "@components/features-9.tsx",
      "content": "import { ChartBarStacked, MessageCircle, Vote } from 'lucide-react'\nimport { Message } from '@/components/illustrations/message'\nimport { Poll } from '@/components/illustrations/poll'\nimport { Uptime } from '@/components/illustrations/uptime'\nimport { Card } from '@/components/ui/card'\n\nexport default function FeaturesSectionNine() {\n    return (\n        <section className=\"@container py-24\">\n            <div className=\"mx-auto w-full max-w-5xl px-6\">\n                <div className=\"@max-4xl:max-w-sm @max-4xl:mx-auto @4xl:grid-cols-3 grid gap-3 *:p-6\">\n                    <Card className=\"bg-card/50 grid grid-rows-[auto_1fr] space-y-12 overflow-hidden\">\n                        <div>\n                            <MessageCircle className=\"fill-foreground/10 mb-5 size-4\" />\n                            <h3 className=\"text-foreground text-lg font-semibold\">Real-time Messaging</h3>\n                            <p className=\"text-muted-foreground mt-3\">\n                                Connect instantly with <span className=\"text-foreground font-medium\">end-to-end encryption</span>.\n                            </p>\n                        </div>\n                        <div className=\"relative -m-8 flex flex-col items-end justify-center p-8\">\n                            <Message />\n                        </div>\n                    </Card>\n                    <Card className=\"bg-card/50 grid grid-rows-[auto_1fr] space-y-12 overflow-hidden\">\n                        <div>\n                            <ChartBarStacked className=\"fill-foreground/10 mb-5 size-4\" />\n                            <h3 className=\"text-foreground text-lg font-semibold\">Performance Analytics</h3>\n                            <p className=\"text-muted-foreground mt-3\">\n                                Track metrics with <span className=\"text-foreground font-medium\">customizable dashboards</span>.\n                            </p>\n                        </div>\n                        <div className=\"-m-8 flex flex-col items-end justify-center p-8\">\n                            <div className=\"mt-6 w-full\">\n                                <Uptime />\n                            </div>\n                        </div>\n                    </Card>\n                    <Card className=\"bg-card/50 grid grid-rows-[auto_1fr] space-y-12 overflow-hidden\">\n                        <div>\n                            <Vote className=\"fill-foreground/10 mb-5 size-4\" />\n                            <h3 className=\"text-foreground text-lg font-semibold\">Interactive Polling</h3>\n                            <p className=\"text-muted-foreground mt-3\">\n                                Gather feedback with <span className=\"text-foreground font-medium\">real-time results</span>.\n                            </p>\n                        </div>\n                        <div className=\"-m-8 flex flex-col items-end justify-center p-8\">\n                            <div className=\"w-full px-2\">\n                                <Poll />\n                            </div>\n                        </div>\n                    </Card>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/features/nine/illustrations/message.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/message.tsx",
      "content": "import Image from 'next/image'\n\nconst MESCHAC_AVATAR = 'https://avatars.githubusercontent.com/u/47919550?v=4'\n\nexport const Message = () => (\n    <div aria-hidden>\n        <div className=\"flex items-center gap-2\">\n            <Image\n                src={MESCHAC_AVATAR}\n                className=\"size-4 rounded-full\"\n                alt=\"Méschac Irung\"\n                width=\"46\"\n                height=\"46\"\n            />\n            <span className=\"text-sm\">Irung</span>\n        </div>\n\n        <div className=\"ring-border-illustration bg-illustration mt-2 w-fit rounded-2xl rounded-tl p-3 text-sm shadow ring-1\">\n            Hey <span className=\"text-primary\">@bernard</span>, I've updated the dashboard metrics.\n        </div>\n    </div>\n)\n"
    },
    {
      "path": "blocks/features/nine/illustrations/poll.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/poll.tsx",
      "content": "import Image from \"next/image\"\n\nexport const Poll = () => {\n  return (\n    <div aria-hidden className=\"relative w-full select-none\">\n      <div className=\"relative w-full space-y-2 py-4\">\n        <div className=\"absolute inset-y-0 left-0 w-px bg-[linear-gradient(180deg,var(--color-foreground)_1px,transparent_1px)] bg-size-[1px_4px] bg-repeat-y opacity-25\"></div>\n\n        <div className=\"pl-5\">\n          <div className=\"relative mt-0.5 inline-flex items-center gap-2 text-sm font-medium text-foreground before:absolute before:inset-y-0 before:left-[-22px] before:my-auto before:size-[5px] before:rounded-full before:border before:border-muted-foreground before:bg-background before:ring before:ring-background\">\n            <div className=\"text-xs text-muted-foreground\">06 AM</div>\n            Poll Created\n          </div>\n        </div>\n        <div className=\"relative -mx-5 flex rounded-xl bg-illustration p-2 text-xs shadow ring-1 shadow-black/10 ring-border-illustration\">\n          <div className=\"relative mt-0.5 ml-7 inline-flex items-center gap-2 text-sm font-medium before:absolute before:inset-y-0 before:left-[-19px] before:my-auto before:size-[5px] before:rounded-full before:border before:border-primary before:bg-background before:ring before:ring-background\">\n            <div className=\"flex items-center -space-x-2\">\n              {[\n                {\n                  src: \"https://avatars.githubusercontent.com/u/47919550?v=4\",\n                  alt: \"Méschac Irung\",\n                },\n                {\n                  src: \"https://avatars.githubusercontent.com/u/31113941?v=4\",\n                  alt: \"Bernard Ngandu\",\n                },\n              ].map((avatar, index) => (\n                <div\n                  key={index}\n                  className=\"size-6 rounded-full border bg-background p-0.5 shadow shadow-zinc-950/5 *:rounded-full\"\n                >\n                  <Image\n                    src={avatar.src}\n                    className=\"aspect-square rounded-[calc(var(--avatar-radius)-2px)] object-cover\"\n                    alt={avatar.alt}\n                    width=\"40\"\n                    height=\"40\"\n                  />\n                </div>\n              ))}\n            </div>\n            +50 Users voted\n          </div>\n        </div>\n        <div className=\"pl-5\">\n          <div className=\"relative mt-0.5 inline-flex items-center gap-2 text-sm font-medium text-foreground before:absolute before:inset-y-0 before:left-[-22px] before:my-auto before:size-[5px] before:rounded-full before:border before:border-muted-foreground before:bg-background before:ring before:ring-background\">\n            <div className=\"text-xs text-muted-foreground\">01 PM</div>\n            Poll Closed\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n"
    },
    {
      "path": "blocks/features/nine/illustrations/uptime.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/uptime.tsx",
      "content": "export const Uptime = () => (\n    <div\n        aria-hidden\n        className=\"bg-illustration ring-border-illustration shadow-black/6.5 space-y-2.5 rounded-2xl p-4 shadow ring-1\">\n        <div className=\"flex justify-between text-sm\">\n            <span className=\"text-muted-foreground\">Uptime</span>\n            <span className=\"text-foreground\">99.9%</span>\n        </div>\n        <div className=\"flex justify-between gap-px\">\n            {Array.from({ length: 38 }).map((_, index) => (\n                <div\n                    key={index}\n                    className=\"[:nth-child(10)]:bg-foreground/25 [:nth-child(11)]:bg-foreground/25 [:nth-child(22)]:bg-foreground/25 [:nth-child(23)]:bg-foreground/25 [:nth-child(24)]:bg-foreground/25 [:nth-child(32)]:bg-foreground/25 h-7 w-1 rounded bg-emerald-500\"></div>\n            ))}\n        </div>\n    </div>\n)\n"
    }
  ]

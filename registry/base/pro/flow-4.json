{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "flow-4",
  "type": "registry:component",
  "title": "Flow Illustration",
  "description": "Tailark 4 flow illustration",
  "dependencies": [
    "motion"
  ],
  "meta": {
    "category": "flow",
    "variant": "4"

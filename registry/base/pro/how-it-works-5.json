      "content": "export const DocumentCsv = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"relative size-fit\">\n            <div className=\"z-2 after:border-foreground/15 text-shadow-sm absolute -right-3 bottom-2 rounded bg-teal-500 px-1.5 py-0.5 text-[10px] font-semibold text-white shadow-lg shadow-teal-900/25 after:absolute after:inset-0 after:rounded after:border\">CSV</div>\n            <div className=\"bg-illustration corner-tr-bevel ring-border-illustration z-1 shadow-black/6.5 relative w-16 space-y-2 rounded-md rounded-tr-[15%] p-2 shadow-md ring-1\">\n                <div className=\"space-y-[3px]\">\n                    <div className=\"flex gap-0.5\">\n                        <div className=\"bg-foreground/15 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/15 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/15 h-2 flex-1 rounded-sm\" />\n                    </div>\n                    <div className=\"flex gap-0.5\">\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                    </div>\n                    <div className=\"flex gap-0.5\">\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                    </div>\n                    <div className=\"flex gap-0.5\">\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                    </div>\n                    <div className=\"flex gap-0.5\">\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                    </div>\n                    <div className=\"flex gap-0.5\">\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                    </div>\n                    <div className=\"flex gap-0.5\">\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                        <div className=\"bg-foreground/5 h-2 flex-1 rounded-sm\" />\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n\nexport default DocumentCsv\n"
    },
    {

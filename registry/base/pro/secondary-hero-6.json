    {
      "path": "blocks/secondary-hero/six/index.tsx",
      "type": "registry:component",
      "target": "@components/secondary-hero-6.tsx",
      "content": "import React from 'react'\nimport Link from 'next/link'\nimport { Button } from '@/components/ui/button'\nimport { Flow } from '@/components/illustrations/flow'\nimport LogoCloud from './logo-cloud'\n\nexport default function HeroSection() {\n    return (\n        <section className=\"bg-background overflow-hidden pb-8 pt-24\">\n            <div className=\"mx-auto max-w-5xl px-6\">\n                <div className=\"mb-20 text-center *:mx-auto\">\n                    <span className=\"text-primary text-sm font-medium\">Billing</span>\n                    <h1 className=\"mt-6 max-w-2xl text-balance text-4xl font-semibold md:text-5xl lg:text-6xl tracking-tight\">Streamline Your Invoicing Process</h1>\n                    <p className=\"text-muted-foreground mb-6 mt-4 max-w-3xl text-balance text-lg\">Simple and secure user authentication, complete with everything you need out-of-the-box to provide a secure experience for your users.</p>\n\n                    <Button\n                        render={<Link href=\"#link\">Get Started</Link>}\n                        nativeButton={false}\n                        size=\"sm\"\n                    />\n                    <Button\n                        render={<Link href=\"#link\">Get a demo</Link>}\n                        nativeButton={false}\n                        variant=\"outline\"\n                        className=\"ml-3!\"\n                        size=\"sm\"\n                    />\n                </div>\n                <Flow />\n                <LogoCloud />\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/secondary-hero/six/logo-cloud.tsx",
      "type": "registry:component",
      "target": "@components/logo-cloud.tsx",
      "content": "import { Beacon } from '@/components/ui/svgs/beacon'\nimport { Bolt } from '@/components/ui/svgs/bolt'\nimport { Cisco } from '@/components/ui/svgs/cisco'\nimport { Hulu } from '@/components/ui/svgs/hulu'\nimport { OpenAIFull } from '@/components/ui/svgs/open-ai'\nimport { Primevideo } from '@/components/ui/svgs/prime'\nimport { Stripe } from '@/components/ui/svgs/stripe'\nimport { VisualStudioCode } from '@/components/ui/svgs/vs-code'\nimport { InfiniteSlider } from '@/components/motion-primitives/infinite-slider'\n\nexport default function LogoCloud() {\n    return (\n        <div className=\"mx-auto max-w-3xl\">\n            <div className=\"mask-x-from-90% py-16\">\n                <InfiniteSlider\n                    speedOnHover={20}\n                    speed={40}\n                    className=\"*:gap-12! **:fill-foreground md:*:gap-24! items-center\">\n                    <Hulu\n                        height={20}\n                        width=\"auto\"\n                    />\n                    <Beacon\n                        height={24}\n                        width=\"auto\"\n                    />\n                    <Cisco\n                        height={24}\n                        width=\"auto\"\n                    />\n                    <Primevideo\n                        height={32}\n                        width=\"auto\"\n                    />\n                    <Stripe\n                        height={20}\n                        width=\"auto\"\n                    />\n                    <OpenAIFull\n                        height={24}\n                        width=\"auto\"\n                    />\n                    <VisualStudioCode\n                        height={24}\n                        width=\"auto\"\n                    />\n\n                    <Bolt\n                        height={20}\n                        width=\"auto\"\n                    />\n                </InfiniteSlider>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/secondary-hero/six/illustrations/document.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/document.tsx",
      "content": "import { Signature } from 'lucide-react'\n\nexport const Document = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"bg-illustration ring-border-illustration shadow-black/6.5 w-16 shrink-0 space-y-2 rounded-md p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)]\">\n            <div className=\"flex items-center gap-1\">\n                <div className=\"bg-border size-2.5 rounded-full\" />\n                <div className=\"bg-border h-[3px] w-4 rounded-full\" />\n            </div>\n            <div className=\"space-y-1.5\">\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                    <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                </div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                    <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                </div>\n            </div>\n\n            <div className=\"space-y-1.5\">\n                <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                    <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                </div>\n            </div>\n\n            <Signature className=\"ml-auto size-3\" />\n        </div>\n    )\n}\n\nexport default Document\n"
    },
    {
      "path": "blocks/secondary-hero/six/illustrations/flow.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/flow.tsx",
      "content": "import { ArrowBigDown, ArrowBigRight } from 'lucide-react'\nimport { Invoice } from '@/components/illustrations/invoice'\nimport { Vercel } from '@/components/ui/svgs/vercel'\nimport { Supabase } from '@/components/ui/svgs/supabase'\nimport { Firebase } from '@/components/ui/svgs/firebase'\nimport { cn } from '@/lib/utils'\n\nexport const Flow = () => {\n    return (\n        <div className=\"relative h-fit\">\n            <div\n                aria-hidden\n                className=\"absolute inset-0 mx-auto flex max-w-5xl flex-col justify-between\">\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed\" />\n\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n                <div className=\"border-foreground/10 dark:border-foreground/5 h-px border-b border-dashed md:hidden\" />\n            </div>\n            <div\n                aria-hidden\n                className=\"absolute inset-0 m-auto max-w-4xl\">\n                <div className=\"w-1/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 left-0 border-l border-dashed\" />\n                <div className=\"w-1/11 left-1/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-l border-dashed\" />\n                <div className=\"w-1/11 left-2/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-l border-dashed\" />\n                <div className=\"w-1/11 left-3/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-x border-dashed\" />\n                <div className=\"w-1/11 left-5/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-x border-dashed\" />\n                <div className=\"w-1/11 left-6/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-r border-dashed\" />\n                <div className=\"w-1/11 left-7/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-r border-dashed\" />\n                <div className=\"w-1/11 left-8/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-r border-dashed\" />\n                <div className=\"w-1/11 left-9/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-r border-dashed\" />\n                <div className=\"w-1/11 left-10/11 border-foreground/10 dark:border-foreground/5 absolute -inset-y-4 border-r border-dashed\" />\n            </div>\n            <div className=\"relative mx-auto grid max-w-4xl px-px max-md:gap-6 md:grid-cols-11\">\n                <div className=\"flex flex-wrap items-center justify-center gap-2 md:col-span-3\">\n                    <div className=\"relative origin-top -translate-y-5 scale-75\">\n                        {[\n                            { name: 'Vercel', icon: Vercel },\n                            { name: 'Supabase', icon: Supabase },\n                            { name: 'Firebase', icon: Firebase },\n                        ].map((node, index) => (\n                            <div\n                                key={node.name}\n                                className=\"bg-illustration not-first:absolute nth-2:rotate-15 nth-3:-rotate-19 not-first:inset-0 nth-2:top-12 nth-3:top-24 ring-border-illustration shadow-black/6.5 h-fit w-28 space-y-3 rounded-xl p-3 pb-6 shadow-md ring-1\">\n                                <div className=\"flex items-center justify-between\">\n                                    <div className=\"text-xs font-medium leading-tight\">\n                                        {node.name} <br /> Usage\n                                    </div>\n\n                                    <div className={cn('shrink-0 *:size-5', node.name === 'Vercel' && '*:fill-foreground')}>\n                                        <node.icon />\n                                    </div>\n                                </div>\n                                <div className=\"space-y-1.5 self-start\">\n                                    <div className=\"space-y-1.5\">\n                                        {[1, 2].map((row) => (\n                                            <div\n                                                key={row}\n                                                className=\"flex gap-2\">\n                                                <div className=\"bg-foreground/10 h-1 flex-1 rounded-full\" />\n                                                <div className=\"bg-foreground/10 h-1 w-8 rounded-full\" />\n                                            </div>\n                                        ))}\n\n                                        <div className=\"flex gap-2\">\n                                            <div className=\"bg-foreground/10 h-1 w-full rounded-full\" />\n                                        </div>\n                                        <div className=\"flex gap-1\">\n                                            <div className=\"bg-foreground/10 h-1 w-1/3 rounded-full\" />\n                                            <div className=\"bg-foreground/10 h-1 w-1/3 rounded-full\" />\n                                        </div>\n                                        <div className=\"mt-4 flex gap-1\">\n                                            <div className=\"bg-foreground/10 h-1 w-2/3 rounded-full\" />\n                                            <div className=\"bg-foreground/10 h-1 w-1/3 rounded-full\" />\n                                        </div>\n                                        <div className=\"flex gap-1\">\n                                            <div className=\"bg-foreground/10 h-1 w-1/3 rounded-full\" />\n                                            <div className=\"bg-foreground/10 h-1 w-1/3 rounded-full\" />\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        ))}\n                    </div>\n                </div>\n                <div className=\"flex items-center justify-center max-md:pt-4 dark:opacity-50\">\n                    <ArrowBigRight\n                        strokeWidth={4}\n                        className=\"fill-illustration dark:fill-foreground stroke-illustration dark:stroke-foreground m-auto size-6 drop-shadow-sm max-md:hidden\"\n                    />\n                    <ArrowBigDown\n                        strokeWidth={4}\n                        className=\"fill-illustration dark:fill-foreground stroke-illustration dark:stroke-foreground mt-auto size-6 drop-shadow-sm md:hidden\"\n                    />\n                </div>\n\n                <div className=\"-ml-px flex flex-col items-center justify-center overflow-hidden border-r border-t max-md:mx-auto max-md:size-fit md:col-span-3\">\n                    <div className=\"shadow-black/6.5 bg-illustration ring-border pt-22 size-56 -translate-y-4 translate-x-4 rounded-bl-xl p-6 shadow ring-1\">\n                        <div className=\"relative w-fit translate-y-3 border border-blue-500/50 px-5 py-3\">\n                            <div className=\"absolute -inset-0.5 flex flex-col justify-between\">\n                                <div className=\"flex justify-between\">\n                                    <div className=\"size-1 bg-blue-500\" />\n                                    <div className=\"size-1 bg-blue-500\" />\n                                    <div className=\"size-1 bg-blue-500\" />\n                                </div>\n                                <div className=\"flex justify-between\">\n                                    <div className=\"size-1 bg-blue-500\" />\n                                    <div className=\"size-1 bg-blue-500\" />\n                                </div>\n                                <div className=\"flex justify-between\">\n                                    <div className=\"size-1 bg-blue-500\" />\n                                    <div className=\"size-1 bg-blue-500\" />\n                                    <div className=\"size-1 bg-blue-500\" />\n                                </div>\n                            </div>\n                            <svg\n                                height=\"81\"\n                                viewBox=\"0 0 204 81\"\n                                fill=\"none\"\n                                xmlns=\"http://www.w3.org/2000/svg\"\n                                className=\"h-10 translate-y-2\">\n                                <path\n                                    d=\"M0.67 62.98C0.22 62.98 0 62.59 0 61.82C0 61.18 0.13 60.42 0.38 59.52C0.7 58.6
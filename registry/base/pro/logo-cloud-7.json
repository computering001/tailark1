                 height={20}\n                                width=\"auto\"\n                            />\n                        </div>\n                        <div className=\"flex items-center justify-center px-2\">\n                            <Beacon\n                                height={16}\n                                width=\"auto\"\n                            />\n                        </div>\n                        <div className=\"flex items-center justify-center px-2\">\n                            <VercelFull\n                                height={16}\n                                width=\"auto\"\n                            />\n                        </div>\n\n                        <div className=\"flex items-center justify-center px-2\">\n                            <Stripe\n                                height={20}\n                                width=\"auto\"\n                            />\n                        </div>\n                        <div className=\"flex items-center justify-center px-2\">\n                            <TailwindCSS\n                                height={20}\n                                width=\"auto\"\n                            />\n                        </div>\n                        <div className=\"flex items-center justify-center px-2\">\n                            <Stripe\n                                height={20}\n                                width=\"auto\"\n                            />\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n"

{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "contact-8",
  "type": "registry:block",
  "title": "Contact 8",
  "description": "Tailark contact variant 8 block",
  "registryDependencies": [
    "@tailark/button",
    "@tailark/card",
    "@tailark/input",
    "@tailark/label",
    "@tailark/textarea"
  ],
  "meta": {
    "aspect-ratio": "6/5",
    "width": 686,
    "height": 572
  },
  "files": [
    {
      "path": "blocks/contact/eight/index.tsx",
      "type": "registry:component",
      "target": "@components/contact-8.tsx",
      "content": "import React from 'react'\nimport Link from 'next/link'\nimport { Card } from '@/components/ui/card'\n\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\nimport { Textarea } from '@/components/ui/textarea'\nimport { Button } from '@/components/ui/button'\n\nexport default function Contact() {\n    return (\n        <section className=\"bg-background py-24\">\n            <div className=\"@container mx-auto max-w-5xl px-2\">\n                <div className=\"mx-auto max-w-4xl\">\n                    <div className=\"px-4 text-center\">\n                        <h1 className=\"text-balance text-4xl font-semibold md:text-5xl lg:tracking-tight tracking-tight\">Contact us</h1>\n                        <p className=\"text-muted-foreground mt-4 text-balance text-lg\">Find answers to your questions and get support for our services.</p>\n                    </div>\n                    <Card className=\"mx-auto mt-12 flex max-w-xl flex-col p-6 shadow-xl md:p-12\">\n                        <h2 className=\"text-foreground font-medium\">Talk to our team</h2>\n                        <p className=\"text-muted-foreground mt-2 text-sm\">Fill out the form and we'll be in touch within 24 hours.</p>\n\n                        <form className=\"**:data-[slot=label]:block relative mt-12 space-y-6\">\n                            <div className=\"grid gap-4 sm:grid-cols-2\">\n                                <div className=\"space-y-2.5\">\n                                    <Label htmlFor=\"first-name\">First name</Label>\n                                    <Input\n                                        id=\"first-name\"\n                                        placeholder=\"John\"\n                                        required\n                                    />\n                                </div>\n                                <div className=\"space-y-2.5\">\n                                    <Label htmlFor=\"last-name\">Last name</Label>\n                                    <Input\n                                        id=\"last-name\"\n                                        placeholder=\"Doe\"\n                                        required\n                                    />\n                                </div>\n                            </div>\n\n                            <div className=\"space-y-2.5\">\n                                <Label htmlFor=\"email\">Professional Email</Label>\n                                <Input\n                                    id=\"email\"\n                                    type=\"email\"\n                                    placeholder=\"name@company.com\"\n                                    required\n                                />\n                            </div>\n\n                            <div className=\"space-y-2.5\">\n                                <Label htmlFor=\"company\">Company</Label>\n                                <Input\n                                    id=\"company\"\n                                    type=\"text\"\n                                    placeholder=\"Company Name\"\n                                    required\n                                />\n                            </div>\n\n                            <div className=\"space-y-2.5\">\n                                <Label htmlFor=\"message\">Message</Label>\n                                <Textarea\n                                    id=\"message\"\n                                    placeholder=\"Tell us about your project...\"\n                                    rows={7}\n                                    required\n                                    className=\"min-h-32\"\n                                />\n                            </div>\n\n                            <Button\n                                type=\"submit\"\n                                className=\"w-full\">\n                                Send message\n                            </Button>\n                        </form>\n                    </Card>\n\n                    <div className=\"@lg:grid-cols-2 mx-auto mt-6 grid max-w-xl gap-4\">\n                        <div className=\"flex flex-col space-y-2.5 p-6 md:p-12\">\n                            <h2 className=\"text-muted-foreground text-sm font-medium\">Collaborate</h2>\n                            <Link\n                                href=\"mailto:hey@tailark.com\"\n                                className=\"hover:decoration-primary font-medium hover:underline\">\n                                hey@tailark.com\n                            </Link>\n                            <Link\n                                href=\"tel:+6581234567\"\n                                className=\"hover:decoration-primary font-medium hover:underline\">\n                                +65 8123 4567\n                            </Link>\n                        </div>\n                        <div className=\"flex flex-col space-y-2.5 p-6 md:p-12\">\n                            <h2 className=\"text-muted-foreground text-sm font-medium\">Press</h2>\n                            <Link\n                                href=\"mailto:hey@tailark.com\"\n                                className=\"hover:decoration-primary font-medium hover:underline\">\n                                press@tailark.com\n                            </Link>\n                            <Link\n                                href=\"tel:+6581234567\"\n                                className=\"hover:decoration-primary font-medium hover:underline\">\n                                +65 8123 4567\n                            </Link>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    }
  ]
}

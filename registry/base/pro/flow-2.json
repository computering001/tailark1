      "content": "\"use client\"\n\nimport { Database, Server, Cloud } from \"lucide-react\"\nimport { LogoIcon } from \"@/components/ui/logo\"\n\nexport const Flow2Illustration = () => {\n  return (\n    <div\n      aria-hidden\n      className=\"relative flex min-h-120 w-fit min-w-120 flex-col items-center justify-center\"\n    >\n      <style jsx>{`\n        @keyframes source-to-logo {\n          0% {\n            stroke-dashoffset: 400;\n          }\n          100% {\n            stroke-dashoffset: 0;\n          }\n        }\n        @keyframes logo-to-outputs {\n          0% {\n            stroke-dashoffset: 550;\n          }\n          10% {\n            stroke-dashoffset: 400;\n          }\n          100% {\n            stroke-dashoffset: 0;\n          }\n        }\n      `}</style>\n\n      <svg\n        viewBox=\"0 0 173 165\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        className=\"pointer-events-none absolute inset-0 mx-auto h-full w-1/2 text-foreground/15\"\n      >\n        <path\n          d=\"M92.5 81.5V119.18C92.5 128.01 99.66 135.18 108.5 135.18H156.5C165.34 135.18 172.5 142.34 172.5 151.18V164.5\"\n          stroke=\"currentColor\"\n          strokeLinecap=\"round\"\n        />\n        <path\n          d=\"M80.5 81.5V119.18C80.5 128.01 73.34 135.18 64.5 135.18H16.5C7.66 135.18 0.5 142.34 0.5 151.18V164.5\"\n          stroke=\"currentColor\"\n          strokeLinecap=\"round\"\n        />\n        <path d=\"M86.5 81V164.5\" stroke=\"currentColor\" strokeLinecap=\"round\" />\n        <path d=\"M86.5 0.5V80.5\" stroke=\"currentColor\" strokeLinecap=\"round\" />\n\n        {/* animated paths */}\n\n        <path\n          d=\"M86.5 0.5V80.5\"\n          stroke=\"url(#flow2-source)\"\n          strokeLinecap=\"round\"\n          strokeDasharray=\"4 30\"\n          strokeDashoffset=\"30\"\n          className=\"not-group-hover:opacity-0 group-hover:animate-[source-to-logo_2s_linear_infinite]\"\n        />\n        <path\n          d=\"M92.5 81.5V119.18C92.5 128.01 99.66 135.18 108.5 135.18H156.5C165.34 135.18 172.5 142.34 172.5 151.18V164.5\"\n          stroke=\"url(#flow2-right)\"\n          strokeLinecap=\"round\"\n          strokeDasharray=\"4 40\"\n          strokeDashoffset=\"40\"\n          className=\"not-group-hover:opacity-0 group-hover:animate-[logo-to-outputs_3s_linear_infinite]\"\n        />\n        <path\n          d=\"M80.5 81.5V119.18C80.5 128.01 73.34 135.18 64.5 135.18H16.5C7.66 135.18 0.5 142.34 0.5 151.18V164.5\"\n          stroke=\"url(#flow2-left)\"\n          strokeLinecap=\"round\"\n          strokeDasharray=\"4 40\"\n          strokeDashoffset=\"40\"\n          className=\"not-group-hover:opacity-0 group-hover:animate-[logo-to-outputs_3s_linear_infinite]\"\n        />\n        <path\n          d=\"M86.5 81V164.5\"\n          stroke=\"url(#flow2-center)\"\n          strokeLinecap=\"round\"\n          strokeDasharray=\"4 30\"\n          strokeDashoffset=\"40\"\n          className=\"not-group-hover:opacity-0 group-hover:animate-[logo-to-outputs_3s_linear_infinite]\"\n        />\n        <defs>\n          <linearGradient\n            id=\"flow2-source\"\n            gradientUnits=\"userSpaceOnUse\"\n            x1=\"86.5\"\n            y1=\"0\"\n            x2=\"86.5\"\n            y2=\"81\"\n          >\n            <stop offset=\"0%\" stopColor=\"transparent\" />\n            <stop offset=\"50%\" stopColor=\"var(--color-cyan-400)\" />\n            <stop offset=\"100%\" stopColor=\"transparent\" />\n          </linearGradient>\n          <linearGradient\n            id=\"flow2-center\"\n            gradientUnits=\"userSpaceOnUse\"\n            x1=\"86.5\"\n            y1=\"81\"\n            x2=\"86.5\"\n            y2=\"165\"\n          >\n            <stop\n              offset=\"0%\"\n              stopColor=\"var(--color-background)\"\n              stopOpacity={0}\n            />\n            <stop offset=\"100%\" stopColor=\"var(--color-violet-400)\" />\n          </linearGradient>\n          <linearGradient\n            id=\"flow2-right\"\n            gradientUnits=\"userSpaceOnUse\"\n            x1=\"92\"\n            y1=\"81\"\n            x2=\"173\"\n            y2=\"165\"\n          >\n            <stop\n              offset=\"0%\"\n              stopColor=\"var(--color-background)\"\n              stopOpacity={0}\n            />\n            <stop offset=\"100%\" stopColor=\"var(--color-amber-400)\" />\n          </linearGradient>\n          <linearGradient\n            id=\"flow2-left\"\n            gradientUnits=\"userSpaceOnUse\"\n            x1=\"81\"\n            y1=\"81\"\n            x2=\"0\"\n            y2=\"165\"\n          >\n            <stop\n              offset=\"0%\"\n              stopColor=\"var(--color-background)\"\n              stopOpacity={0}\n            />\n\n            <stop offset=\"100%\" stopColor=\"var(--color-emerald-400)\" />\n          </linearGradient>\n        </defs>\n      </svg>\n\n      <div className=\"bg-illustration ring-border-illustration relative z-10 flex items-center gap-2 rounded-xl p-1 pr-3 shadow-md ring-1 shadow-cyan-800/10\">\n        <div className=\"relative flex size-9 items-center justify-center rounded-lg bg-cyan-500/10 after:absolute after:inset-0 after:rounded-lg after:border after:border-foreground/5\">\n          <Database className=\"size-4 text-cyan-500\" />\n        </div>\n        <div>\n          <div className=\"text-xs font-semibold\">Data Source</div>\n          <div className=\"text-[10px] text-foreground/50\">PostgreSQL</div>\n        </div>\n      </div>\n\n      <div className=\"relative z-10 my-18\">\n        <div className=\"dark:bg-illustration/75 dark:ring-border-illustration relative flex size-14 items-center justify-center rounded-full bg-black/75 shadow-xl ring-1 shadow-black/20 ring-black backdrop-blur\">\n          <LogoIcon className=\"size-5\" />\n        </div>\n      </div>\n\n      {/* Bottom: Outputs */}\n      <div className=\"relative z-10 flex gap-6\">\n        <div className=\"bg-illustration ring-border-illustration flex items-center gap-1.5 rounded-xl p-1 pr-3 shadow-md ring-1 shadow-emerald-800/10\">\n          <div className=\"relative flex size-8 items-center justify-center rounded-lg bg-emerald-500/10 after:absolute after:inset-0 after:rounded-lg after:border after:border-foreground/5\">\n            <Server className=\"size-4 text-emerald-500\" />\n          </div>\n          <div className=\"text-[10px] font-medium\">Cache</div>\n        </div>\n        <div className=\"bg-illustration ring-border-illustration flex items-center gap-1.5 rounded-xl p-1 pr-3 shadow-md ring-1 shadow-violet-800/10\">\n          <div className=\"relative flex size-8 items-center justify-center rounded-lg bg-violet-500/10 after:absolute after:inset-0 after:rounded-lg after:border after:border-foreground/5\">\n            <Cloud className=\"size-4 text-violet-500\" />\n          </div>\n          <div className=\"text-[10px] font-medium\">CDN</div>\n        </div>\n        <div className=\"bg-illustration ring-border-illustration flex items-center gap-1.5 rounded-xl p-1 pr-3 shadow-md ring-1 shadow-amber-800/10\">\n          <div className=\"relative flex size-8 items-center justify-center rounded-lg bg-amber-500/10 after:absolute after:inset-0 after:rounded-lg after:border after:border-foreground/5\">\n            <Database className=\"size-4 text-amber-500\" />\n          </div>\n          <div className=\"text-[10px] font-medium\">Backup</div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default Flow2Illustration\n"

{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "expandable-features-7",
  "type": "registry:block",
  "title": "Expandable Features 7",
  "description": "Tailark expandable-features variant 7 block",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [
    "@tailark/button",
    "@tailark/core-utils"

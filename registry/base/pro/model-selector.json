{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "model-selector",
  "type": "registry:component",
  "title": "Model Selector Illustration",
  "description": "Tailark model-selector illustration",
  "registryDependencies": [
    "@tailark/core-claude",
    "@tailark/core-openai",
    "@tailark/core-gemini"
  ],
  "meta": {
    "col-span": "2",

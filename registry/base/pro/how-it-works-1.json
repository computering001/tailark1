    {
      "path": "blocks/how-it-works/one/index.tsx",
      "type": "registry:component",
      "target": "@components/how-it-works-1.tsx",
      "content": "import { Invoice } from '@/components/illustrations/invoice'\nimport { InvoiceSigning } from '@/components/illustrations/invoice-signing'\nimport { Payment } from '@/components/illustrations/payment'\n\nexport default function FeaturesSection() {\n    return (\n        <section className=\"bg-background @container py-16 md:py-24 lg:py-40\">\n            <div className=\"@max-6xl:px-6 relative mx-auto w-full max-w-5xl\">\n                <div className=\"@max-4xl:max-w-sm mx-auto\">\n                    <div className=\"@max-4xl:gap-12 @4xl:grid-cols-3 grid\">\n                        <div className=\"row-span-2 grid grid-rows-subgrid gap-8\">\n                            <div className=\"@4xl:pr-12\">\n                                <h3 className=\"text-balance text-lg font-semibold\">\n                                    <span className=\"text-muted-foreground self-center font-mono text-sm\">1.</span> Add payment information\n                                </h3>\n                                <p className=\"text-muted-foreground mt-2\">\n                                    Securely add your <span className=\"text-foreground font-medium\">payment details</span> to get started with our services.\n                                </p>\n                            </div>\n                            <IllustrationPerspective>\n                                <Payment />\n                            </IllustrationPerspective>\n                        </div>\n                        <div className=\"row-span-2 grid grid-rows-subgrid gap-8\">\n                            <div className=\"@4xl:pr-12\">\n                                <h3 className=\"text-balance text-lg font-semibold\">\n                                    <span className=\"text-muted-foreground self-center font-mono text-sm\"> 2.</span> Sign documents\n                                </h3>\n                                <p className=\"text-muted-foreground mt-2\">\n                                    Digitally sign and <span className=\"text-foreground font-medium\">authorize transactions</span> with ease.\n                                </p>\n                            </div>\n                            <IllustrationPerspective>\n                                <InvoiceSigning />\n                            </IllustrationPerspective>\n                        </div>\n                        <div className=\"row-span-2 grid grid-rows-subgrid gap-8\">\n                            <div className=\"@4xl:pr-12\">\n                                <h3 className=\"text-balance text-lg font-semibold\">\n                                    <span className=\"text-muted-foreground self-center font-mono text-sm\">3.</span> Receive confirmation\n                                </h3>\n                                <p className=\"text-muted-foreground mt-2\">\n                                    Get instant <span className=\"text-foreground font-medium\">confirmation receipts</span> for all your completed transactions.\n                                </p>\n                            </div>\n                            <IllustrationPerspective>\n                                <Invoice />\n                            </IllustrationPerspective>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n}\n\nconst IllustrationPerspective = ({ children }: { children: React.ReactNode }) => (\n    <div className=\"perspective-dramatic mask-radial-from-60% mask-radial-at-top-left mask-radial-[95%_100%] @4xl:pl-4 pl-5 pt-6\">\n        <div className=\"rotate-y-3 -skew-y-4\">{children}</div>\n    </div>\n)\n"
    },
    {
      "path": "blocks/how-it-works/one/illustrations/document.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/document.tsx",
      "content": "import { Signature } from 'lucide-react'\n\nexport const Document = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"bg-illustration ring-border-illustration w-16 space-y-2 rounded-md p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)]\">\n            <div className=\"flex items-center gap-1\">\n                <div className=\"bg-foreground/15 size-2.5 rounded-full\"></div>\n                <div className=\"bg-foreground/15 h-[3px] w-4 rounded-full\"></div>\n            </div>\n            <div className=\"space-y-1.5\">\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n            </div>\n\n            <div className=\"space-y-1.5\">\n                <div className=\"bg-foreground/15 h-[3px] w-full rounded-full\"></div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2/3 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-1/3 rounded-full\"></div>\n                </div>\n            </div>\n\n            <Signature className=\"ml-auto size-3\" />\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/how-it-works/one/illustrations/invoice-signing.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/invoice-signing.tsx",
      "content": "import { LogoIcon } from \"@/components/ui/logo\"\nimport { cn } from '@/lib/utils'\n\nexport const InvoiceSigning = ({ className }: { className?: string }) => {\n    return (\n        <div\n            aria-hidden\n            className={cn(className)}>\n            <div className=\"bg-card ring-border-illustration shadow-black/6.5 relative overflow-hidden rounded-2xl p-8 text-sm shadow-lg ring-1\">\n                <div className=\"space-y-0.5\">\n                    <LogoIcon />\n                    <div className=\"mt-4 font-mono text-xs\">INV-456789</div>\n                    <div className=\"mt-1 -translate-x-1 font-mono text-2xl font-semibold\">$284,342.57</div>\n                    <div className=\"text-xs font-medium\">Due in 15 days</div>\n                </div>\n\n                <div className=\"border-foreground/15 bg-foreground/5 my-6 flex h-24 items-center justify-center rounded-md border border-dashed\">\n                    <div className=\"border-b px-6 font-serif\">Sign here</div>\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/how-it-works/one/illustrations/invoice.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/invoice.tsx",
      "content": "import { cn } from '@/lib/utils'\nimport { LogoIcon } from \"@/components/ui/logo\"\nimport { Document } from '@/components/illustrations/document'\n\nexport const Invoice = ({ className }: { className?: string }) => {\n    return (\n        <div\n            aria-hidden\n            className={cn(className)}>\n            <div className=\"bg-card ring-border-illustration shadow-black/6.5 relative overflow-hidden rounded-2xl border border-transparent p-8 text-sm shadow-lg ring-1\">\n                <div className=\"mb-6 flex items-start justify-between [--color-background:color-mix(in_oklab,var(--color-foreground)10%,var(--color-zinc-950))]\">\n                    <div className=\"space-y-0.5\">\n                        <LogoIcon />\n                        <div className=\"mt-4 font-mono text-xs\">INV-456789</div>\n                        <div className=\"mt-1 -translate-x-1 font-mono text-2xl font-semibold\">$284,342.57</div>\n                        <div className=\"text-xs font-medium\">Due in 15 days</div>\n                    </div>\n                    <Document />\n                </div>\n\n                <div className=\"mb-12 space-y-1.5 [--color-border:color-mix(in_oklab,var(--color-foreground)10%,transparent)]\">\n                    <div className=\"grid grid-cols-[auto_1fr] items-center\">\n                        <span className=\"text-muted-foreground w-18 block\">To</span>\n                        <span className=\"bg-border h-2 w-1/4 rounded-full px-2\" />\n                    </div>\n\n                    <div className=\"grid grid-cols-[auto_1fr] items-center\">\n                        <span className=\"text-muted-foreground w-18 block\">From</span>\n                        <span className=\"bg-border h-2 w-1/2 rounded-full px-2\" />\n                    </div>\n\n                    <div className=\"grid grid-cols-[auto_1fr] items-center\">\n                        <span className=\"text-muted-foreground w-18 block\">Address</span>\n                        <span className=\"bg-border h-2 w-2/3 rounded-full px-2\" />\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {

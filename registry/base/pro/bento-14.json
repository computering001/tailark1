  "files": [
    {
      "path": "blocks/bento/fourteen/index.tsx",
      "type": "registry:component",
      "target": "@components/bento-14.tsx",
      "content": "import { Currency } from '@/components/illustrations/currency'\nimport { Document } from '@/components/illustrations/document'\nimport { Map } from '@/components/illustrations/map'\nimport { MonitoringChart } from './monitoring-chart'\n\nexport default function Bento14() {\n    return (\n        <section className=\"bg-background @container py-24\">\n            <div className=\"mx-auto w-full max-w-5xl px-6\">\n                <div className=\"@3xl:grid-cols-6 @3xl:*:p-12 grid border *:p-8\">\n                    <div className=\"@3xl:gap-12 @3xl:border-r @max-3xl:border-b @3xl:col-span-2 row-span-2 grid grid-rows-subgrid gap-8\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Currency Conversion</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Real-time exchange rates for global transactions.</p>\n                        </div>\n\n                        <div className=\"space-y-6\">\n                            <Currency />\n                            <span className=\"text-muted-foreground text-sm\">+44 Currencies</span>\n                        </div>\n                    </div>\n                    <div className=\"@3xl:gap-12 @3xl:col-span-4 row-span-2 grid grid-rows-subgrid gap-8\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Global Analytics</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Visualize your business performance across different regions with interactive map-based reporting.</p>\n                        </div>\n                        <Map />\n                    </div>\n                    <div className=\"@3xl:gap-12 @3xl:border-r @3xl:col-span-4 row-span-2 grid grid-rows-subgrid gap-8 border-t\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Performance Monitoring</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Track key metrics in real-time with customizable dashboards that highlight important trends and anomalies.</p>\n                        </div>\n                        <MonitoringChart />\n                    </div>\n                    <div className=\"@3xl:gap-12 @3xl:col-span-2 row-span-2 grid grid-rows-subgrid gap-8 border-t\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Document Management</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Organize and access all your important files.</p>\n                        </div>\n                        <div className=\"relative flex flex-wrap gap-4\">\n                            <Document />\n                            <Document />\n                            <Document />\n                            <Document />\n                            <Document />\n                            <Document />\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/fourteen/map.tsx",
      "type": "registry:component",
      "target": "@components/map.tsx",
      "content": "'use client'\nimport DottedMap from 'dotted-map'\n\nconst map = new DottedMap({ height: 55, grid: 'vertical' })\n\nconst points = map.getPoints()\n\nconst svgOptions = {\n    backgroundColor: 'var(--color-background)',\n    color: 'currentColor',\n    radius: 0.15,\n}\n\nexport const Map = () => {\n    const viewBox = `0 0 120 60`\n    return (\n        <svg\n            viewBox={viewBox}\n            style={{ background: svgOptions.backgroundColor }}>\n            {points.map((point, index) => (\n                <circle\n                    key={index}\n                    cx={point.x}\n                    cy={point.y}\n                    r={svgOptions.radius}\n                    fill={svgOptions.color}\n                />\n            ))}\n        </svg>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/fourteen/monitoring-chart.tsx",
      "type": "registry:component",
      "target": "@components/monitoring-chart.tsx",
      "content": "'use client'\nimport dynamic from 'next/dynamic'\nimport { type ChartConfig, ChartContainer, ChartTooltipContent } from '@/components/ui/chart'\n\nconst chartConfig = {\n    desktop: {\n        label: 'Desktop',\n        color: 'var(--color-indigo-400)',\n    },\n    mobile: {\n        label: 'Mobile',\n        color: 'var(--color-emerald-400)',\n    },\n} satisfies ChartConfig\n\nconst chartData = [\n    { month: 'January', desktop: 56, mobile: 224 },\n    { month: 'February', desktop: 56, mobile: 224 },\n    { month: 'March', desktop: 126, mobile: 252 },\n    { month: 'April', desktop: 205, mobile: 410 },\n    { month: 'May', desktop: 200, mobile: 126 },\n    { month: 'June', desktop: 400, mobile: 800 },\n]\n\ntype RechartsChartProps = import('react').ComponentProps<(typeof import('recharts'))['AreaChart']>\n\nconst RechartsChart = dynamic<RechartsChartProps>(() =>\n    import('recharts').then(({ Area, AreaChart, CartesianGrid, Tooltip, XAxis }) => {\n        function LoadedChart(props: RechartsChartProps) {\n            return (\n                <AreaChart\n                    {...props}\n                    accessibilityLayer\n                    data={chartData}\n                    margin={{\n                        left: 0,\n                        right: 0,\n                    }}>\n                    <defs>\n                        <linearGradient id=\"fillDesktop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"15%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-desktop)\" stopOpacity={0.3} />\n                        </linearGradient>\n                        <linearGradient id=\"fillMobile\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.8} />\n                            <stop offset=\"55%\" stopColor=\"var(--color-mobile)\" stopOpacity={0.3} />\n                        </linearGradient>\n                    </defs>\n                    <CartesianGrid vertical={false} />\n                    <Tooltip active cursor={false} content={<ChartTooltipContent className=\"dark:bg-muted\" />} />\n                    <XAxis dataKey=\"month\" tickLine={false} tickMargin={10} stroke=\"transparent\" />\n                    <Area strokeWidth={1} dataKey=\"mobile\" type=\"monotone\" fill=\"url(#fillMobile)\" fillOpacity={0.1} stroke=\"var(--color-mobile)\" stackId=\"a\" />\n                    <Area strokeWidth={1} dataKey=\"desktop\" type=\"monotone\" fill=\"url(#fillDesktop)\" fillOpacity={0.1} stroke=\"var(--color-desktop)\" stackId=\"a\" />\n                </AreaChart>\n            )\n        }\n\n        return LoadedChart\n    })\n)\n\nexport const MonitoringChart = () => {\n    return (\n        <ChartContainer className=\"-mb-8 aspect-auto h-60\" config={chartConfig}>\n            <RechartsChart />\n        </ChartContainer>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/fourteen/illustrations/const.ts",
      "type": "registry:component",
      "target": "@components/illustrations/const.ts",
      "content": "const MESCHAC_AVATAR = 'https://avatars.githubusercontent.com/u/47919550?v=4'\nconst BERNARD_AVATAR = 'https://avatars.githubusercontent.com/u/31113941?v=4'\nconst THEO_AVATAR = 'https://avatars.githubusercontent.com/u/68236786?v=4'\nconst GLODIE_AVATAR = 'https://avatars.githubusercontent.com/u/99137927?v=4'\n\nexport { BERNARD_AVATAR, GLODIE_AVATAR, THEO_AVATAR, MESCHAC_AVATAR }\n"
    },
    {
      "path": "blocks/bento/fourteen/illustrations/currency.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/currency.tsx",
      "content": "import { Bitcoin, DollarSign, Euro, Signature } from 'lucide-react'\n\nexport const Currency = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"flex -space-x-4\">\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-blue-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-blue-900 dark:text-blue-300\">\n                    <Bitcoin className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">BTC</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-green-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-green-900 dark:text-green-300\">\n                    <DollarSign className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">USD</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-red-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-red-900 dark:text-red-300\">\n                    <Euro className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">EURO</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/fourteen/illustrations/document.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/document.tsx",
      "content": "import { Signature } from 'lucide-react'\nimport { cn } from '@/lib/utils'\n\nexport const Document = ({ className }: { className?: string }) => {\n    return (\n        <div className={cn('bg-illustration ring-border-illustration shadow-black/6.5 w-16 space-y-2 rounded-md p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)]', className)}>\n            <div className=\"flex items-center gap-1\">\n                <div className=\"bg-foreground/15 size-2.5 rounded-full\"></div>\n                <div className=\"bg-foreground/15 h-[3px] w-4 rounded-full\"></div>\n            </div>\n            <div className=\"space-y-1.5\">\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n            </div>\n\n            <div className=\"space-y-1.5\">\n                <div className=\"bg-foreground/15 h-[3px] w-full rounded-full\"></div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2/3 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-1/3 rounded-full\"></div>\n                </div>\n            </div>\n\n            <Signature className=\"ml-auto size-3\" />\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/fourteen/illustrations/map.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/map.tsx",
      "content": "import Image from 'next/image'\nimport { BERNARD_AVATAR, GLODIE_AVATAR, THEO_AVATAR } from '@/components/illustrations/const'\nimport { Map as DottedMap } from '@/components/map'\n\nexport const Map = () => (\n    <div\n        aria-hidden\n        className=\"mask-radial-from-25% relative [--color-background:transparent]\">\n        <div className=\"absolute inset-6 -mb-12\">\n            <div className=\"absolute left-1/3 top-1/3 z-10 size-8 -translate-x-full rounded-full bg-white p-0.5 shadow-md shadow-black/15\">\n                <Image\n                    className=\"aspect-square rounded-full object-cover\"\n                    src={GLODIE_AVATAR}\n                    alt=\"Glodie\"\n                    height=\"52\"\n                    width=\"52\"\n                />\n            </div>\n            <div className=\"absolute right-1/2 top-1/2 z-10 size-8 -translate-y-full translate-x-full rounded-full bg-white p-0.5 shadow-md shadow-black/15\">\n                <Image\n                    className=\"aspect-square rounded-full object-cover\"\n                    src={THEO_AVATAR}\n                    alt=\"Theo\"\n                    height=\"52\"\n                    width=\"52\"\n                />\n            </div>\n            <div className=\"absolute right-1/4 top-1/3 z-10 size-8 -translate-y-full translate-x-full rounded-full bg-white p-0.5 shadow-md shadow-black/15\">\n                <Image\n                    className=\"aspect-square rounded-full object-cover\"\n                    src={BERNARD_AVATAR}\n                    alt=\"Bernard\"\n                    height=\"52\"\n                    width=\"52\"\n                />\n            </div>\n        </div>\n        <div className=\"isolate -mb-12 opacity-75\">\n            <DottedMap />\n        </div>\n    </div>\n)\n"
    }
  ]
}

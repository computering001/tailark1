  "files": [
    {
      "path": "blocks/bento/twelve/index.tsx",
      "type": "registry:component",
      "target": "@components/bento-12.tsx",
      "content": "import { Currency } from '@/components/illustrations/currency'\nimport { FileUpload } from '@/components/illustrations/file-upload'\nimport { Schedule } from '@/components/illustrations/schedule'\nimport { Chat } from '@/components/illustrations/chat'\nimport { Reply } from '@/components/illustrations/reply'\n\nexport default function BentoTwelve() {\n    return (\n        <section className=\"bg-background @container py-24\">\n            <div className=\"mx-auto w-full max-w-5xl px-6\">\n                <div className=\"@3xl:grid @3xl:grid-cols-2 @3xl:*:p-12 border *:p-8\">\n                    <div className=\"@3xl:gap-12 @3xl:border-r row-span-2 grid grid-rows-subgrid gap-8 border-b\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Financial Analytics</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Track revenue streams and expense categories with real-time financial dashboards that highlight growth opportunities.</p>\n                        </div>\n                        <Currency />\n                    </div>\n                    <div className=\"@3xl:gap-12 row-span-2 grid grid-rows-subgrid gap-8 border-b\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Seamless File Sharing</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Upload and share documents securely with team members or clients while maintaining version control and access permissions.</p>\n                        </div>\n                        <FileUpload variant=\"mixed\" />\n                    </div>\n                    <div className=\"@3xl:col-span-2 @3xl:gap-22 @3xl:grid-cols-2 border-background grid gap-8 border-y\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">AI-Powered Chat Support</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Get instant answers to your questions with our intelligent chat assistant that learns from your interactions to provide personalized help.</p>\n                        </div>\n                        <Chat />\n                    </div>\n                    <div className=\"@3xl:gap-12 @3xl:border-r row-span-2 grid grid-rows-subgrid gap-8 border-t\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Team Collaboration</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Streamline communication with integrated comment threads that keep discussions organized and accessible within your projects.</p>\n                        </div>\n                        <Reply className=\"self-end\" />\n                    </div>\n                    <div className=\"@3xl:gap-12 row-span-2 grid grid-rows-subgrid gap-8 border-t\">\n                        <div>\n                            <h3 className=\"text-foreground text-xl font-semibold\">Smart Scheduling</h3>\n                            <p className=\"text-muted-foreground mt-4 text-lg\">Automate appointment booking and task management with intelligent calendar features that optimize your team's productivity.</p>\n                        </div>\n                        <Schedule className=\"self-end pl-9\" />\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/twelve/illustrations/chat.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/chat.tsx",
      "content": "export const Chat = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"flex flex-col gap-6\">\n            <div>\n                <div className=\"flex items-center gap-2\">\n                    <span className=\"text-muted-foreground text-xs\">Sat 22 Feb</span>\n                </div>\n                <div className=\"rounded-(--radius) bg-card ring-foreground/5 mt-1.5 w-3/5 rounded-tl p-3 text-xs shadow ring-1\">Hey, I'm having trouble with my account.</div>\n            </div>\n\n            <div>\n                <div className=\"rounded-(--radius) bg-primary inset-ring-foreground/25 inset-ring-1 mb-1 ml-auto w-3/5 rounded-br p-3 text-xs text-white shadow shadow-black/15\">Distinctio provident nobis repudiandae deleniti necessitatibus.</div>\n                <span className=\"text-muted-foreground block text-right text-xs\">Now</span>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/twelve/illustrations/currency.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/currency.tsx",
      "content": "import { Bitcoin, DollarSign, Euro, Signature } from 'lucide-react'\n\nexport const Currency = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"flex -space-x-4\">\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-blue-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-blue-900 dark:text-blue-300\">\n                    <Bitcoin className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">BTC</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-green-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-green-900 dark:text-green-300\">\n                    <DollarSign className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">USD</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n            <div className=\"bg-illustration before:bg-linear-to-b ring-border-illustration to-illustration shadow-black/6.5 before:border-foreground/5 before:mask-b-from-65% relative w-16 translate-y-1 -rotate-12 space-y-2 rounded-lg p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)] before:absolute before:inset-0.5 before:rounded-[6px] before:border before:from-red-500/15 before:from-25% before:to-75%\">\n                <div className=\"flex -translate-x-0.5 items-center gap-0.5 text-red-900 dark:text-red-300\">\n                    <Euro className=\"size-3\" />\n                    <span className=\"text-xs font-medium\">EURO</span>\n                </div>\n                <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2.5 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-6 rounded-full\" />\n                    </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                    <div className=\"bg-border h-[3px] w-full rounded-full\" />\n                    <div className=\"flex items-center gap-1\">\n                        <div className=\"bg-border h-[3px] w-2/3 rounded-full\" />\n                        <div className=\"bg-border h-[3px] w-1/3 rounded-full\" />\n                    </div>\n                </div>\n\n                <Signature className=\"ml-auto size-3\" />\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/twelve/illustrations/file-upload.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/file-upload.tsx",
      "content": "import { cn } from \"@/lib/utils\"\n\ninterface IllustrationProps {\n  className?: string\n  variant?: \"elevated\" | \"outlined\" | \"mixed\"\n}\n\nexport const FileUpload = ({\n  className,\n  variant = \"elevated\",\n}: IllustrationProps) => {\n  return (\n    <div aria-hidden className={cn(\"relative w-full\", className)}>\n      <div\n        className={cn(\n          \"group relative grid w-full grid-cols-[auto_1fr] gap-2.5 rounded-2xl bg-illustration p-4 text-xs duration-300\",\n          {\n            \"shadow-lg shadow-black/6.5\": variant === \"elevated\",\n            border: variant === \"outlined\",\n            \"border border-transparent shadow-md ring-1 shadow-black/6.5 ring-border-illustration\":\n              variant === \"mixed\",\n          }\n        )}\n      >\n        <div className=\"relative h-fit\">\n          <div className=\"absolute bottom-1.5 -left-1.5 rounded-md border-t border-red-700 bg-red-500 px-1 py-px text-[10px] font-medium text-white shadow-md shadow-red-500/35\">\n            PDF\n          </div>\n          <div className=\"h-10 w-8 rounded-md border bg-linear-to-b from-gray-100 to-gray-200\" />\n        </div>\n        <div className=\"mt-0.5\">\n          <div className=\"text-sm font-medium\">react-visualizations.pdf</div>\n          <div className=\"relative my-1.5 h-1 overflow-hidden rounded-full bg-foreground/5 before:absolute before:inset-0 before:w-1/3 before:rounded-r-full before:bg-primary before:transition-[width] before:delay-150 before:duration-300 group-hover:before:w-2/3\" />\n          <div className=\"text-xs text-muted-foreground\">29 KB / 120KB</div>\n        </div>\n      </div>\n    </div>\n  )\n}\n"
    },
    {
      "path": "blocks/bento/twelve/illustrations/reply.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/reply.tsx",
      "content": "import { cn } from '@/lib/utils'\nimport { AtSign, Paperclip, Smile } from 'lucide-react'\n\nexport const Reply = ({ className }: { className?: string }) => {\n    return (\n        <div\n            aria-hidden\n            className={cn('bg-illustration ring-border-illustration shadow-black/6.5 shadow-black/6.5 mt-12 flex origin-bottom flex-col space-y-4 rounded-2xl border border-transparent px-4 pb-2 pt-4 shadow ring-1', className)}>\n            <p className=\"text-primary text-sm font-medium\">\n                @Bernard <span className=\"text-muted-foreground font-normal\">Shared 2 invoices</span>\n            </p>\n\n            <div className=\"text-muted-foreground *:hover:text-foreground -ml-1.5 flex\">\n                <div className=\"hover:text-foreground hover:bg-muted flex size-7 rounded-full\">\n                    <AtSign className=\"m-auto size-4\" />\n                </div>\n                <div className=\"hover:text-foreground hover:bg-muted flex size-7 rounded-full\">\n                    <Smile className=\"m-auto size-4\" />\n                </div>\n                <div className=\"hover:text-foreground hover:bg-muted flex size-7 rounded-full\">\n                    <Paperclip className=\"m-auto size-4\" />\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/bento/twelve/illustrations/schedule.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/schedule.tsx",
      "content": "import { cn } from \"@/lib/utils\"\nimport { buttonVariants } from \"@/components/ui/button\"\nimport {\n  ToggleGroup,\n  ToggleGroupItem,\n} from \"@/components/ui/toggle-group\"\nimport {\n  Calendar1,\n  Bold,\n  Italic,\n  Strikethrough,\n  Underline,\n  Ellipsis,\n} from \"lucide-react\"\n\nexport const Schedule = ({ className }: { className?: string }) => {\n  return (\n    <div aria-hidden className={cn(\"relative pt-8\", className)}>\n      <div\n        className={cn(\n          \"absolute flex -translate-x-1/8 translate-y-[-110%] items-center gap-2 rounded-xl border border-foreground/10 bg-background p-1 shadow-md shadow-black/6.5\"\n        )}\n      >\n        <div\n          className={buttonVariants({\n            size: \"sm\",\n            variant: \"default\",\n            className: \"ml-0.5 [--color-primary-foreground:var(--color-white)]\",\n          })}\n        >\n          <Calendar1 className=\"size-3\" />\n          <span className=\"text-sm font-medium\">Schedule</span>\n        </div>\n        <span className=\"block h-4 w-px bg-border\"></span>\n        <ToggleGroup multiple size=\"sm\" className=\"gap-0.5 *:rounded-md\">\n          <ToggleGroupItem value=\"bold\" aria-label=\"Toggle bold\">\n            <Bold className=\"size-4\" />\n          </ToggleGroupItem>\n          <ToggleGroupItem value=\"italic\" aria-label=\"Toggle italic\">\n            <Italic className=\"size-4\" />\n          </ToggleGroupItem>\n          <ToggleGroupItem value=\"underline\" aria-label=\"Toggle underline\">\n            <Underline className=\"size-4\" />\n          </ToggleGroupItem>\n          <ToggleGroupItem\n            value=\"strikethrough\"\n            aria-label=\"Toggle strikethrough\"\n          >\n            <Strikethrough className=\"size-4\" />\n          </ToggleGroupItem>\n        </ToggleGroup>\n        <span className=\"block h-4 w-px bg-border\"></span>\n        <div\n          className={buttonVariants({\n            size: \"icon\",\n            variant: \"ghost\",\n          })}\n        >\n          <Ellipsis className=\"size-3\" />\n        </div>\n      </div>\n      <span>\n        <span className=\"bg-primary/10 py-1 font-medium text-primary\">\n          Tomorrow 8:30 pm\n        </span>{\" \"}\n        is our priority.\n      </span>\n    </div>\n  )\n}\n"
    }
  ]
}

{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "expandable-features-11",
  "type": "registry:block",
  "title": "Expandable Features 11",
  "description": "Tailark expandable-features variant 11 block",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [
    "@tailark/core-antigravity",
    "@tailark/core-cursor",
    "@tailark/core-figma",
    "@tailark/core-firebase",
    "@tailark/core-logo",
    "@tailark/core-pdf",
    "@tailark/core-supabase",
    "@tailark/core-utils",
    "@tailark/core-vercel",
    "@tailark/core-windsurf"
  ],

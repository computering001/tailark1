  "files": [
    {
      "path": "blocks/login-blocks/nine/index.tsx",
      "type": "registry:component",
      "target": "@components/login-blocks-9.tsx",
      "content": "'use client'\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\nimport { Button } from '@/components/ui/button'\nimport { LogoIcon } from \"@/components/ui/logo\"\nimport { Vercel } from '@/components/ui/svgs/vercel'\nimport { Slack } from '@/components/ui/svgs/slack'\n\nimport { useState } from 'react'\n\nimport Link from 'next/link'\n\nexport default function Login() {\n    const [password, setPassword] = useState('')\n\n    return (\n        <main className=\"bg-background\">\n            <div className=\"grid min-h-dvh grid-rows-[1fr_auto] gap-6 p-6 pt-24\">\n                <div className=\"mx-auto w-full max-w-72 self-center\">\n                    <Link\n                        href=\"#\"\n                        aria-label=\"go home\"\n                        className=\"-ml-2.5 flex size-10 *:m-auto\">\n                        <LogoIcon className=\"size-7\" />\n                    </Link>\n\n                    <div className=\"my-10 space-y-2\">\n                        <h1 className=\"text-2xl font-semibold\">Log in</h1>\n                        <p className=\"text-muted-foreground text-sm\">Log in to continue</p>\n                    </div>\n\n                    <form\n                        action=\"\"\n                        className=\"space-y-5\">\n                        <div className=\"space-y-2.5\">\n                            <Label\n                                htmlFor=\"email-signin\"\n                                className=\"block\">\n                                Email\n                            </Label>\n                            <Input\n                                type=\"email\"\n                                id=\"email-signin\"\n                                required\n                                placeholder=\"name@company.com\"\n                            />\n                        </div>\n                        <div className=\"space-y-2.5\">\n                            <Label\n                                htmlFor=\"password-signin\"\n                                className=\"block\">\n                                Password <span className=\"text-muted-foreground\">(optional)</span>\n                            </Label>\n\n                            <Input\n                                type=\"password\"\n                                id=\"password-signin\"\n                                required\n                                placeholder=\"Enter your password\"\n                                value={password}\n                                onChange={(e) => setPassword(e.target.value)}\n                            />\n                        </div>\n                        <Button\n                            type=\"submit\"\n                            className=\"w-full\">\n                            {password ? 'Sign In' : 'Send Magic Link'}\n                        </Button>\n                    </form>\n\n                    <div className=\"my-6 grid grid-cols-[1fr_auto_1fr] items-center gap-3\">\n                        <div className=\"bg-border border-card h-0.5 border-b\" />\n                        <div className=\"text-muted-foreground text-center text-sm\">or continue with</div>\n                        <div className=\"bg-border border-card h-0.5 border-b\" />\n                    </div>\n\n                    <div className=\"grid grid-cols-2 gap-3\">\n                        <Button\n                            variant=\"outline\"\n                            className=\"w-full\">\n                            <Vercel className=\"size-4\" />\n                            Vercel\n                        </Button>\n                        <Button\n                            variant=\"outline\"\n                            className=\"w-full\">\n                            <Slack className=\"size-4\" />\n                            Slack\n                        </Button>\n                    </div>\n\n                    <p className=\"text-muted-foreground mt-8 text-sm\">\n                        New to Tailark?{' '}\n                        <Link\n                            href=\"#\"\n                            className=\"text-primary font-medium hover:underline\">\n                            Create an account\n                        </Link>\n                    </p>\n                </div>\n\n                <div className=\"mx-auto mt-auto w-fit pt-8\">\n                    <div className=\"flex gap-6\">\n                        <Link\n                            href=\"#\"\n                            className=\"text-muted-foreground hover:text-foreground text-sm\">\n                            Privacy\n                        </Link>\n                        <Link\n                            href=\"#\"\n                            className=\"text-muted-foreground hover:text-foreground text-sm\">\n                            Terms\n                        </Link>\n                        <Link\n                            href=\"#\"\n                            className=\"text-muted-foreground hover:text-foreground text-sm\">\n                            Help\n                        </Link>\n                    </div>\n                </div>\n            </div>\n        </main>\n    )\n}\n"
    }
  ]

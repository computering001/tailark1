{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "logo-cloud-10",
  "type": "registry:block",
  "title": "Logo Cloud 10",
  "description": "Tailark logo-cloud variant 10 block",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [
    "@tailark/core-beacon",
    "@tailark/core-bolt",
    "@tailark/core-cisco",
    "@tailark/core-hulu",
    "@tailark/core-leap-wallet",
    "@tailark/core-open-ai",
    "@tailark/core-paypal",
    "@tailark/core-polars",
    "@tailark/core-prime",
    "@tailark/core-spotify",
    "@tailark/core-stripe",
    "@tailark/core-supabase",
    "@tailark/core-utils",
    "@tailark/core-vercel"

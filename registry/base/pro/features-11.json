{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "features-11",
  "type": "registry:block",
  "title": "Features 11",
  "description": "Tailark features variant 11 block",
  "registryDependencies": [
    "@tailark/button",
    "@tailark/core-gemini",
    "@tailark/core-logo",
    "@tailark/core-replit",
    "@tailark/core-utils"
  ],
  "meta": {
    "aspect-ratio": "80/45",
    "width": 686,
    "height": 386,
    "category-media": true,
    "description": "Feature sections usually come right after the hero, which means they inherit a hard job: prove the headline without asking the visitor to read a product manual."
  },
  "files": [
    {
      "path": "blocks/features/eleven/index.tsx",
      "type": "registry:component",
      "target": "@components/features-11.tsx",
      "content": "import { Integrations } from '@/components/illustrations/integrations'\nimport { Zap, Sparkles, Lock, Cpu } from 'lucide-react'\nimport { Invoice } from '@/components/illustrations/invoice'\nimport { cn } from '@/lib/utils'\n\nexport default function FeaturesSection() {\n    return (\n        <section className=\"bg-background @container py-24\">\n            <div className=\"mx-auto w-full max-w-5xl px-6 xl:px-0\">\n                <div className=\"relative\">\n                    <PlusDecorator className=\"-translate-[calc(50%-0.5px)]\" />\n                    <PlusDecorator className=\"right-0 -translate-y-[calc(50%-0.5px)] translate-x-[calc(50%-0.5px)]\" />\n                    <PlusDecorator className=\"bottom-0 right-0 translate-x-[calc(50%-0.5px)] translate-y-[calc(50%-0.5px)]\" />\n                    <PlusDecorator className=\"bottom-0 -translate-x-[calc(50%-0.5px)] translate-y-[calc(50%-0.5px)]\" />\n\n                    <div className=\"border-foreground/10 *:nth-2:border-r-0 @max-4xl:*:nth-4:border-r-0 @max-4xl:*:nth-5:border-b-0 @max-4xl:*:first:border-r-0 @4xl:*:not-nth-2:border-b-0 *:nth-1:border-b! divide-foreground/10 @4xl:grid-cols-4 @4xl:*:p-8 relative grid grid-cols-2 divide-x divide-y overflow-hidden border *:p-4\">\n                        <div className=\"@4xl:col-span-2 col-span-full row-span-2 grid grid-rows-subgrid gap-8 !p-8\">\n                            <div className=\"max-w-84 mx-auto w-full self-center\">\n                                <Invoice />\n                            </div>\n                            <div className=\"mx-auto max-w-sm text-center\">\n                                <h3 className=\"text-balance font-semibold\">Powerful analytics dashboard</h3>\n                                <p className=\"text-muted-foreground mt-3\">Track performance metrics with real-time data visualization and customizable reports for informed.</p>\n                            </div>\n                        </div>\n                        <div className=\"@4xl:col-span-2 relative col-span-full row-span-2 grid grid-rows-subgrid gap-8 !p-8\">\n                            <PlusDecorator className=\"bottom-0 -translate-x-[calc(50%+0.5px)] translate-y-[calc(50%+0.5px)]\" />\n\n                            <div className=\"@4xl:px-8 mx-auto max-w-sm self-center\">\n                                <Integrations />\n                            </div>\n                            <div className=\"relative z-10 mx-auto max-w-sm text-center\">\n                                <h3 className=\"text-balance font-semibold\">Streamlined invoicing system</h3>\n                                <p className=\"text-muted-foreground mt-3\">Generate, send, and manage professional invoices automatically with integrated payment tracking.</p>\n                            </div>\n                        </div>\n\n                        <div className=\"space-y-3\">\n                            <div className=\"flex items-center gap-2\">\n                                <Zap className=\"text-foreground size-4\" />\n                                <h3 className=\"text-sm font-medium\">Faaast</h3>\n                            </div>\n                            <p className=\"text-muted-foreground text-sm\">It supports an entire helping developers and innovate.</p>\n                        </div>\n                        <div className=\"space-y-2\">\n                            <div className=\"flex items-center gap-2\">\n                                <Cpu className=\"text-foreground size-4\" />\n                                <h3 className=\"text-sm font-medium\">Powerful</h3>\n                            </div>\n                            <p className=\"text-muted-foreground text-sm\">It supports an entire helping developers and businesses.</p>\n                        </div>\n                        <div className=\"space-y-2\">\n                            <div className=\"flex items-center gap-2\">\n                                <Lock className=\"text-foreground size-4\" />\n                                <h3 className=\"text-sm font-medium\">Security</h3>\n                            </div>\n                            <p className=\"text-muted-foreground text-sm\">An helping developers businesses innovate.</p>\n                        </div>\n                        <div className=\"space-y-2\">\n                            <div className=\"flex items-center gap-2\">\n                                <Sparkles className=\"text-foreground size-4\" />\n\n                                <h3 className=\"text-sm font-medium\">AI Powered</h3>\n                            </div>\n                            <p className=\"text-muted-foreground text-sm\">Helping developers businesses innovate.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n}\n\nconst PlusDecorator = ({ className }: { className?: string }) => (\n    <div\n        aria-hidden\n        className={cn('mask-radial-from-15% before:bg-foreground/25 after:bg-foreground/25 absolute size-3 before:absolute before:inset-0 before:m-auto before:h-px after:absolute after:inset-0 after:m-auto after:w-px', className)}\n    />\n)\n"
    },
    {
      "path": "blocks/features/eleven/illustrations/document.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/document.tsx",
      "content": "import { Signature } from 'lucide-react'\n\nexport const Document = () => {\n    return (\n        <div\n            aria-hidden\n            className=\"bg-illustration ring-border-illustration w-16 space-y-2 rounded-md p-2 shadow-md ring-1 [--color-border:color-mix(in_oklab,var(--color-foreground)15%,transparent)]\">\n            <div className=\"flex items-center gap-1\">\n                <div className=\"bg-foreground/15 size-2.5 rounded-full\"></div>\n                <div className=\"bg-foreground/15 h-[3px] w-4 rounded-full\"></div>\n            </div>\n            <div className=\"space-y-1.5\">\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2.5 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-6 rounded-full\"></div>\n                </div>\n            </div>\n\n            <div className=\"space-y-1.5\">\n                <div className=\"bg-foreground/15 h-[3px] w-full rounded-full\"></div>\n                <div className=\"flex items-center gap-1\">\n                    <div className=\"bg-foreground/15 h-[3px] w-2/3 rounded-full\"></div>\n                    <div className=\"bg-foreground/15 h-[3px] w-1/3 rounded-full\"></div>\n                </div>\n            </div>\n\n            <Signature className=\"ml-auto size-3\" />\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/features/eleven/illustrations/integrations.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/integrations.tsx",
      "content": "import { buttonVariants } from '@/components/ui/button'\nimport { Link, Plus } from 'lucide-react'\nimport { Gemini } from '@/components/ui/svgs/gemini'\nimport { Replit } from '@/components/ui/svgs/replit'\n\nexport const Integrations = () => (\n    <div\n        aria-hidden\n        className=\"bg-foreground/5 group rounded-2xl\">\n        <div className=\"flex items-center gap-1.5 px-6 py-2.5 text-sm font-medium\">\n            <Link className=\"size-3.5 opacity-50\" />\n            Integrations\n        </div>\n        <div className=\"relative\">\n            <div className=\"absolute inset-0 scale-100 opacity-100 blur-lg transition-opacity duration-300\">\n                <div className=\"bg-linear-to-r/increasing animate-hue-rotate absolute inset-x-6 bottom-0 top-12 -translate-y-3 from-pink-400 to-purple-400\"></div>\n            </div>\n            <div className=\"bg-card ring-foreground/10 relative overflow-hidden rounded-2xl border border-transparent px-6 py-3 shadow-md shadow-black/5 ring-1\">\n                <Integration\n                    icon={<Gemini />}\n                    name=\"Gemini\"\n                    description=\"The AI model that powers Google's search engine.\"\n                />\n                <Integration\n                    icon={<Replit />}\n                    name=\"Replit\"\n                    description=\"The AI model that powers Google's search engine.\"\n                />\n            </div>\n        </div>\n    </div>\n)\n\nconst Integration = ({ icon, name, description }: { icon: React.ReactNode; name: string; description: string }) => {\n    return (\n        <div className=\"grid grid-cols-[auto_1fr_auto] items-center gap-3 border-b border-dashed py-3 last:border-b-0\">\n            <div className=\"bg-muted border-foreground/5 flex size-12 items-center justify-center rounded-lg border *:size-5\">{icon}</div>\n            <div className=\"space-y-0.5\">\n                <h3 className=\"text-sm font-medium\">{name}</h3>\n                <p className=\"text-muted-foreground line-clamp-1 text-sm\">{description}</p>\n            </div>\n            <div className={buttonVariants({ variant: 'outline', size: 'icon' })}>\n                <Plus className=\"size-4\" />\n            </div>\n        </div>\n    )\n}\n"
    },
    {
      "path": "blocks/features/eleven/illustrations/invoice.tsx",
      "type": "registry:component",
      "target": "@components/illustrations/invoice.tsx",
      "content": "import { cn } from '@/lib/utils'\nimport { LogoIcon } from \"@/components/ui/logo\"\nimport { Document } from '@/components/illustrations/document'\n\nexport const Invoice = ({ className }: { className?: string }) => {\n    return (\n        <div\n            aria-hidden\n            className=\"relative\">\n            <div className={cn('mask-b-from-65% before:bg-background before:border-border after:border-border after:bg-background/50 before:z-1 group relative -mx-4 px-4 pt-6 before:absolute before:inset-x-6 before:bottom-0 before:top-4 before:rounded-2xl before:border after:absolute after:inset-x-9 after:bottom-0 after:top-2 after:rounded-2xl after:border', className)}>\n                <div className=\"bg-illustration ring-border-illustration relative z-10 overflow-hidden rounded-2xl p-8 text-sm shadow-xl shadow-black/10 ring-1\">\n                    <div className=\"mb-6 flex items-start justify-between\">\n                        <div className=\"space-y-0.5\">\n                            <LogoIcon />\n                            <div className=\"mt-4 font-mono text-xs\">INV-456789</div>\n                            <div className=\"mt-1 -translate-x-1 font-mono text-2xl font-semibold\">$284,342.57</div>\n                            <div className=\"text-xs font-medium\">Due in 15 days</div>\n                        </div>\n                        <Document />\n                    </div>\n\n                    <div className=\"space-y-1.5 [--color-border:color-mix(in_oklab,var(--color-foreground)10%,transparent)]\">\n                        <div className=\"grid grid-cols-[auto_1fr] items-center\">\n                            <span className=\"text-muted-foreground w-18 block\">To</span>\n                            <span className=\"bg-border h-2 w-1/4 rounded-full px-2\" />\n                        </div>\n\n                        <div className=\"grid grid-cols-[auto_1fr] items-center\">\n                            <span className=\"text-muted-foreground w-18 block\">From</span>\n                            <span className=\"bg-border h-2 w-1/2 rounded-full px-2\" />\n                        </div>\n\n                        <div className=\"grid grid-cols-[auto_1fr] items-center\">\n                            <span className=\"text-muted-foreground w-18 block\">Address</span>\n                            <span className=\"bg-border h-2 w-2/3 rounded-full px-2\" />\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}\n"
    }
  ]
}
